---
export const prerender = true;
import Base from '../layouts/Base.astro';
import StandardHero from '../components/iso-standard/StandardHero.astro';
import StandardIntro from '../components/iso-standard/StandardIntro.astro';
import DeliverableGrid from '../components/iso-standard/DeliverableGrid.astro';
import FeatureGrid from '../components/iso-standard/FeatureGrid.astro';
import StandardCta from '../components/iso-standard/StandardCta.astro';
import { icons } from '../components/iso-standard/shared';
---
<Base
  title="ISO 9001 Compliance & Certification Sydn | Integpro"
  description="Improve your business performance with ISO 9001 certification services in Sydney. integPRO provides expert quality management system consulting, compliance support, audits, and certification assistance for Australian businesses."
  noindex
>
  <StandardHero
    title='Achieve <span class="gold">ISO 9001</span> Certification'
    text="Build a world-class Quality Management System that drives customer satisfaction, operational excellence, and sustainable business growth."
    ticks={['Full ISO 9001', 'Expert Gap Analysis & Documentation Proven First-Audit', 'Success Rate']}
    image="/images/iso-9001-compliance-certification-sydney/hero-quality-meeting.webp"
    imageAlt="Consultants reviewing quality management documents around a meeting table"
  />

  <StandardIntro
    eyebrow="The Global Standard"
    title="What is ISO 9001?"
    paragraphs={[
      "ISO 9001:2015 is the world's most recognized Quality Management System (QMS) standard, trusted by over 1 million organizations globally. It provides a proven framework to consistently deliver products and services that meet customer and regulatory requirements.",
      'The 2015 revision emphasizes risk-based thinking, leadership engagement, and a process approach to quality. This modern framework helps organizations of all sizes improve efficiency, reduce waste, and drive customer satisfaction.',
      "Whether you're pursuing new business opportunities, meeting tender requirements, or simply want to enhance operational excellence, ISO 9001 certification demonstrates your commitment to quality and continuous improvement.",
    ]}
    features={[
      { icon: icons.globe, title: 'Globally Recognised', text: 'Accepted worldwide as the benchmark for quality management excellence.' },
      { icon: icons.trend, title: 'Risk-Based Approach', text: 'Proactive identification and mitigation of operational risks' },
      { icon: icons.clipboard, title: 'Continuous Improvement', text: 'Systematic processes to drive ongoing optimization and growth' },
      { icon: icons.people, title: 'Customer-Focused', text: 'Enhanced understanding and delivery of customer requirements' },
    ]}
  />

  <DeliverableGrid
    title='What <span class="gold">You Get</span>?'
    sub="Everything you need to achieve and maintain ISO 9001:2015 certification, expertly crafted for your organization."
    note="All documentation customized to your industry and business needs"
    cards={[
      {
        icon: icons.trend, title: 'Gap Analysis Report',
        text: 'Comprehensive assessment of your current systems against ISO 9001:2015 requirements.',
        bullets: ['Current state documentation review', 'Compliance gap identification', 'Priority action roadmap', 'Resource requirements analysis'],
      },
      {
        icon: icons.people, title: 'Quality Manual',
        text: 'Complete documentation suite tailored to your organization and industry',
        bullets: ['Quality policy and objectives', 'Organizational context and scope', 'Standard operating procedures', 'Work instructions and forms'],
      },
      {
        icon: icons.award, title: 'Process Documentation',
        text: 'Structured process maps, workflows, and operational documentation',
        bullets: ['Process flow diagrams and related documents', 'Roles and responsibilities matrix', 'Key performance indicators', 'Process interaction mapping'],
      },
      {
        icon: icons.checkbox, title: 'Internal Audit Program',
        text: 'Comprehensive internal audit framework to maintain compliance',
        bullets: ['Annual audit schedule', 'Audit checklists and templates', 'Auditor training materials', 'Non-conformance tracking system'],
      },
      {
        icon: icons.target, title: 'Management Review',
        text: 'Structured approach to executive oversight and strategic planning',
        bullets: ['Review meeting templates and initial documents', 'Performance dashboard', 'Decision-making framework', 'Improvement action tracking'],
      },
    ]}
  />

  <FeatureGrid
    title='Why <span class="gold">Your Business</span> Needs ISO 9001?'
    sub="Everything you need to achieve and maintain ISO 9001:2015 certification, expertly crafted for your organization."
    cards={[
      { icon: icons.globe, title: 'Win More Tenders', text: 'Many government and large corporate contracts require ISO 9001 certification as a mandatory prerequisite for tender eligibility.' },
      { icon: icons.lock, title: 'Build Customer Trust', text: 'Demonstrate your commitment to quality with internationally recognized certification that reassures clients and partners.' },
      { icon: icons.trend, title: 'Expand Market Access', text: 'Open doors to international markets and supply chains that demand ISO 9001 as a baseline quality standard.' },
      { icon: icons.bank, title: 'Regulatory Requirements', text: 'Align with industry regulations and compliance mandates across sectors including defence, medical, and government.' },
      { icon: icons.people, title: 'Team Performance', text: 'Clearly defined roles, responsibilities, and procedures empower your team to deliver consistent quality.' },
      { icon: icons.search, title: 'Reduce Operational Costs', text: 'Identify inefficiencies, eliminate waste, and streamline processes to improve your bottom line.' },
    ]}
  />

  <DeliverableGrid
    title='ISO 9001 Across <span class="gold">Industries</span>'
    sub="Our consultants have deep experience implementing ISO 9001 across diverse sectors, ensuring industry‑specific requirements are met."
    cards={[
      { icon: icons.defence, title: 'Defence', text: 'Meet stringent quality requirements for defence contracts and supply chains', bullets: ['Essential for DISP compliance and defence procurement'] },
      { icon: icons.manufacturing, title: 'Manufacturing', text: 'Optimize production processes and ensure consistent product quality', bullets: ['Reduce defects, improve efficiency, minimize waste'] },
      { icon: icons.construction, title: 'Construction', text: 'Deliver projects on time and to specification with systematic quality control', bullets: ['Required for major government and infrastructure tenders'] },
      { icon: icons.healthcare, title: 'Medical Devices', text: 'Foundation for ISO 13485 and regulatory compliance in healthcare', bullets: ['Prerequisite for TGA and FDA market access'] },
      { icon: icons.professional, title: 'Professional Services', text: 'Demonstrate service quality and process consistency to clients', bullets: ['Competitive advantage in consulting and advisory sectors'] },
      { icon: icons.education, title: 'Education & Training', text: 'Ensure quality delivery of educational programs', bullets: ['Meet RTO and accreditation quality standards'] },
    ]}
  />

  <StandardCta
    title="Not sure if ISO 9001 applies to your industry?"
    text="ISO 9001 is universally applicable across all sectors and organization sizes. Our experts will help you understand the specific benefits and requirements for your business."
  />
</Base>
