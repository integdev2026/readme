---
import Base from '../layouts/Base.astro';
import { service } from '../lib/schema';
import IsoBar from '../components/iso-service-australia/IsoBar.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import ContactBand from '../components/ContactBand.astro';
import CenterHero from '../components/iso-service-australia/CenterHero.astro';
import ServicePackages from '../components/iso-service-australia/ServicePackages.astro';
import ServiceEcosystem from '../components/iso-service-australia/ServiceEcosystem.astro';
import Faq from '../components/iso-service-australia/Faq.astro';

const img = (id: string) => `/images/iso-service-australia/icon-${id}.webp`;

const why = [
  { icon: 'ce6b54', title: 'Quality Excellence' },
  { icon: '153f8b', title: 'Process Improvement' },
  { icon: '24d773', title: 'Risk Management' },
  { icon: '405fa1', title: 'Global Recognition' },
];

const standards = [
  {
    id: '9001', title: 'ISO 9001', sub: 'Quality Management Systems',
    text: 'The world’s most recognised quality management standard. Demonstrates your commitment to quality and customer satisfaction.',
    industries: 'All industries',
    benefits: ['Improved customer satisfaction', 'Enhanced operational efficiency', 'Better decision making', 'Competitive advantage', 'Increased market opportunities'],
  },
  {
    id: '14001', title: 'ISO 14001', sub: 'Environmental Management Systems',
    text: 'A leading standard for managing environmental responsibilities. Supports organisations to reduce environmental impacts, improve resource use, and build stronger stakeholder trust.',
    industries: 'All industries',
    benefits: ['Reduced environmental impact', 'Improved resource efficiency', 'Lower operational costs', 'Enhanced reputation and stakeholder confidence', 'Access to new markets and tenders'],
  },
  {
    id: '27001', title: 'ISO 27001', sub: 'Information Security Management Systems',
    text: 'The global benchmark for protecting sensitive information. Helps organisations manage cyber risks, safeguard data, and ensure confidentiality, integrity, and availability.',
    industries: 'All industries',
    benefits: ['Protection against data breaches', 'Stronger risk management', 'Improved legal and regulatory compliance', 'Increased customer and stakeholder trust', 'Enhanced business resilience'],
  },
  {
    id: '45001', title: 'ISO 45001', sub: 'Occupational Health & Safety Management Systems',
    text: 'A standard designed to create safer workplaces. Helps organisations identify hazards, reduce OHS risks, and improve employee wellbeing and productivity.',
    industries: 'All industries',
    benefits: ['Reduced workplace injuries and incidents', 'Improved legal and regulatory compliance', 'Higher employee morale and productivity', 'Stronger safety culture', 'Enhanced reputation and client confidence'],
  },
  {
    id: '13485', title: 'ISO 13485', sub: 'Medical Device Quality Management Systems',
    text: 'A globally accepted standard for ensuring the safety and effectiveness of medical devices. Supports organisations in meeting strict regulatory and quality requirements across the product lifecycle.',
    industries: 'Medical device',
    benefits: ['Improved patient safety', 'Stronger regulatory compliance (FDA, TGA, EU, etc.)', 'Higher product quality and consistency', 'Increased market access', 'Greater trust from regulators and customers'],
  },
];

// Grid order matches the live page (row by row).
const benefits = [
  { icon: '153f8b', title: 'Business Growth', text: 'Access new markets and win more contracts with internationally recognised certification.' },
  { icon: '187f81', title: 'Customer Confidence', text: 'Demonstrate commitment to quality and build trust with customers and stakeholders.' },
  { icon: '334a55', title: 'Enhanced Security', text: 'Stand out from competitors and meet tender requirements with ISO certification.' },
  { icon: '30076e', title: 'Cost Reduction', text: 'Improve efficiency, reduce waste, and lower operational costs through better processes.' },
  { icon: 'ce6b54', title: 'Enhanced Security', text: 'Identify and eliminate inefficiencies with systematic quality management.' },
  { icon: '405fa1', title: 'Global Recognition', text: 'Achieve international credibility and expand into global markets confidently.' },
];

// General ISO FAQ for this all-standards page (replaces the ISO 13485 set copied from the old site).
const faqs = [
  { q: 'Which ISO standard does my business need?', a: 'It depends on what your customers, tenders and regulators ask for. ISO 9001 covers quality management, ISO 14001 environmental management, ISO 45001 occupational health and safety, ISO 27001 information security and ISO 13485 quality management for medical devices. In a free consultation we look at your contracts and goals and recommend where to start.' },
  { q: 'Does integPRO issue the ISO certificate?', a: 'No. Certificates are issued by an independent, accredited certification body after its audit. Certification bodies must stay independent of consultants, so we prepare your business for the audit and support you through it, and you choose the certification body.' },
  { q: 'How long does ISO certification take?', a: 'It depends on the size of your business, the standard and how much is already in place. A small business with good existing processes can move faster than a larger or more complex one. After a gap analysis we give you a realistic timeline.' },
  { q: 'How much does ISO certification cost?', a: 'There are two costs: consulting to build and implement the management system, and the certification body\'s audit fees. Both depend on your size, scope and the number of sites. We give you a fixed quote after the free consultation.' },
  { q: 'What happens at the certification audit?', a: 'Accredited certification is normally a two-stage audit. Stage 1 reviews your documented system and readiness. Stage 2 checks that the system works in practice. Any nonconformities must be addressed before the certificate is issued.' },
  { q: 'What happens after certification?', a: 'The certification body runs surveillance audits, usually every year, and a recertification audit every three years. You keep the system working through internal audits, management reviews and continual improvement. We can support you with these.' },
  { q: 'Can we certify to more than one standard at once?', a: 'Yes. Standards such as ISO 9001, 14001 and 45001 share a common structure, so they can be combined into one integrated management system with shared processes, audits and reviews. This usually saves time and effort compared with running them separately.' },
  { q: 'Do we need a consultant?', a: 'Not necessarily. Some businesses implement a standard themselves. A consultant helps you interpret the requirements, avoid unnecessary paperwork and prepare for the audit, which can save time for busy teams.' },
];
---
<Base
  schema={[service(Astro.site!, { name: 'ISO Certification Consulting', description: 'ISO certification consulting across Australia for ISO 9001, 14001, 45001, 27001 and 13485, from gap analysis to certification audit and ongoing support.', path: '/iso-service-australia', serviceType: 'ISO certification consulting' })]}
  title="ISO Certification Consultants Australia | integPRO"
  description="Sydney-based ISO consultants helping businesses across Australia achieve ISO 9001, 14001, 45001, 27001 and 13485 certification, from gap analysis to audit."
>
  <IsoBar />
  <CenterHero
    title='Achieve <span class="gold">ISO Certification</span> with <span class="gold">Confidence</span>'
    text="Expert guidance from gap analysis to certification. We make ISO compliance straightforward, efficient, and aligned with your business goals."
    actions={[{ label: 'Get Started', href: '#contact' }]}
    stats={[{ value: '2019', label: 'Established' }, { value: '5', label: 'ISO Standards' }, { value: 'Free', label: 'First Consultation' }]}
    bg="/images/iso-service-australia/hero-bg.webp"
  />

  <VideoEmbed id="t0kn4f4Xg0w" title="ISO certification explained: video" spaced autoplay />

  <section class="section why">
    <div class="container">
      <div class="section-head light">
        <h2>Why <span class="gold">ISO</span> Certification?</h2>
        <p class="wide">ISO standards provide internationally recognised frameworks for quality management, risk mitigation, and operational excellence across all industries.</p>
      </div>
      <div class="mini-grid">
        {why.map((w) => (
          <article class="mini">
            <img src={img(w.icon)} alt="" width="44" height="44" loading="lazy" />
            <h3>{w.title}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section services">
    <div class="container">
      <div class="section-head light">
        <h2>Our ISO <span class="gold">Services</span></h2>
        <p>Comprehensive consulting and training for all major ISO standards.</p>
      </div>
      <div class="tabs">
        {standards.map((s, i) => <input type="radio" name="iso-std" id={`std-${s.id}`} checked={i === 0} />)}
        <div class="tab-bar" role="tablist">
          {standards.map((s) => <label for={`std-${s.id}`} role="tab">{s.id}</label>)}
        </div>
        {standards.map((s) => (
          <div class={`tab-panel panel-${s.id}`} role="tabpanel">
            <div>
              <h3>{s.title}</h3>
              <p class="sub">{s.sub}</p>
              <p>{s.text}</p>
              <p class="industries"><strong>Industries:</strong> {s.industries}</p>
            </div>
            <div>
              <p class="sub">Key Benefits:</p>
              <ul class="checks">{s.benefits.map((b) => <li>{b}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ServicePackages />

  <section class="section benefits">
    <div class="container">
      <div class="section-head light">
        <h2><span class="gold">Benefits</span> of ISO Certification</h2>
        <p class="wide">Transform your business with internationally recognised quality standards.</p>
      </div>
      <div class="card-grid swipe">
        {benefits.map((b) => (
          <article class="card benefit">
            <img src={img(b.icon)} alt="" width="48" height="48" loading="lazy" />
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ServiceEcosystem />

  <Faq items={faqs} />

  <ContactBand
    title='<span class="gold">Get Started</span>'
    sub="Contact us for a free consultation and assessment."
  />
</Base>

<style>
  .section-head.light h2 { font-weight: 400; }
  .section-head .wide { max-width: 640px; }

  .why { padding-top: 24px; }
  .mini-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .mini { display: grid; justify-items: center; gap: 22px; padding: 34px 16px 40px; background: #fff; border-radius: 16px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06); text-align: center; }
  .mini img { width: 48px; height: 48px; border-radius: 50%; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3); }
  .mini h3 { font-family: var(--font-body); font-size: 15px; }

  .services { padding-top: 40px; }
  .tabs input { position: absolute; opacity: 0; pointer-events: none; }
  .tab-bar { display: grid; grid-template-columns: repeat(5, 1fr); background: #fff; border-radius: 999px; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1); }
  .tab-bar label { height: 34px; display: grid; place-items: center; border-radius: 999px; cursor: pointer; font-family: var(--font-heading); font-size: 18px; color: var(--ink); }
  .tab-panel { display: none; grid-template-columns: 1fr 1fr; gap: 80px; margin-top: 32px; padding: 44px 56px 46px; background: var(--bg-faq); border-radius: var(--radius-card); }
  .tab-panel h3 { font-weight: 400; font-size: 20px; color: var(--gold); }
  .tab-panel p { margin: 22px 0 0; font-size: 15px; line-height: 1.5; max-width: 370px; }
  .tab-panel .sub { margin-top: 8px; font-style: italic; font-weight: 700; color: var(--ink); font-size: 16px; letter-spacing: -0.3px; }
  .tab-panel > div:last-child .sub { margin-top: 36px; }
  .industries { padding-top: 26px; border-top: 1px solid #e0e0e0; max-width: 324px; }
  .industries strong { font-weight: 400; color: var(--ink); }
  .checks { list-style: none; margin: 22px 0 0; padding: 0; font-size: 15px; line-height: 1.5; }
  .checks li::before { content: '✔'; margin-right: 6px; color: var(--gold-light); font-size: 13px; }
  #std-9001:checked ~ .tab-bar label[for='std-9001'],
  #std-14001:checked ~ .tab-bar label[for='std-14001'],
  #std-27001:checked ~ .tab-bar label[for='std-27001'],
  #std-45001:checked ~ .tab-bar label[for='std-45001'],
  #std-13485:checked ~ .tab-bar label[for='std-13485'] { background: var(--gold-gradient); }
  #std-9001:checked ~ .panel-9001,
  #std-14001:checked ~ .panel-14001,
  #std-27001:checked ~ .panel-27001,
  #std-45001:checked ~ .panel-45001,
  #std-13485:checked ~ .panel-13485 { display: grid; }
  .tabs input:focus-visible ~ .tab-bar { outline: 2px solid var(--gold); outline-offset: 4px; }

  .benefits { padding-top: 120px; }
  .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card { background: #fff; border-radius: var(--radius-card); box-shadow: var(--shadow-card); }
  .benefit { display: grid; justify-items: center; align-content: start; padding: 28px 40px 60px; text-align: center; }
  .benefit img { width: 48px; height: 48px; border-radius: 6px; }
  .benefit h3 { margin-top: 16px; font-size: 20px; letter-spacing: 0.8px; }
  .benefit p { margin: 14px 0 0; font-size: 14px; line-height: 1.4; }

  @media (max-width: 860px) {
    .mini-grid { grid-template-columns: 1fr 1fr; }
    .card-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .tab-bar label { font-size: 14px; }
    .tab-panel { grid-template-columns: 1fr; gap: 0; padding: 28px 24px; }
    .card-grid { grid-template-columns: 1fr; }
    .benefits { padding-top: 56px; }
    .why { padding-top: 16px; }
  }
  /* Phones: trim the empty space at the bottom of cards. */
  @media (max-width: 760px) {
    .benefit { padding: 24px 22px 26px; }
  }
</style>
