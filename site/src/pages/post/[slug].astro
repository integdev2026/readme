---
import Base from '../../layouts/Base.astro';
import CategoryNav from '../../components/blog/CategoryNav.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { coverUrl, formatDate, getCategories, getPosts, metaDescription, type Post } from '../../lib/wix';
import { ricosToHtml } from '../../lib/ricos';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const [posts, categories] = await Promise.all([getPosts(), getCategories()]);
const recent = posts.filter((p) => p.id !== post.id).slice(0, 3);
const postCats = categories.filter((c) => post.categoryIds?.includes(c.id));
const html = ricosToHtml(post.richContent);
const pageUrl = new URL(`/post/${post.slug}`, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  datePublished: post.firstPublishedDate,
  image: coverUrl(post, 1200),
  author: { '@type': 'Organization', name: 'integPRO' },
  publisher: { '@type': 'Organization', name: 'integPRO' },
  mainEntityOfPage: pageUrl,
};
const share = [
  { label: 'Share on Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`, icon: 'f' },
  { label: 'Share on X', href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}`, icon: 'X' },
  { label: 'Share on LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`, icon: 'in' },
];
---
<Base title={post.title} description={metaDescription(post)} noindex>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="container">
    <CategoryNav categories={categories} variant="plain" />
  </div>
  <article class="post container">
    <p class="meta">{formatDate(post.firstPublishedDate)} · {post.minutesToRead} min read</p>
    <h1>{post.title}</h1>
    <div class="content" set:html={html} />
    {postCats.length > 0 && (
      <p class="tags">{postCats.map((c) => <a href={`/blog/categories/${c.slug}`}>{c.label}</a>)}</p>
    )}
    <ul class="share">
      {share.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>{s.icon}</a></li>)}
    </ul>
  </article>
  {recent.length > 0 && (
    <section class="recent container">
      <div class="recent-head"><h2>Recent Posts</h2><a href="/blog">See All</a></div>
      <div class="grid">{recent.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}
</Base>

<style>
  .post { max-width: 740px; padding: 40px 16px 30px; }
  .meta { font-size: 12px; margin: 0 0 16px; }
  h1 { font-size: 32px; line-height: 1.3; color: var(--gold); margin-bottom: 20px; }
  .content { font-size: 16px; line-height: 1.6; color: var(--text); }
  .content :global(h2), .content :global(h3), .content :global(h4) { color: var(--gold); margin: 28px 0 8px; font-size: 22px; line-height: 1.3; }
  .content :global(h3) { font-size: 19px; }
  .content :global(p) { margin: 0 0 14px; }
  .content :global(ul), .content :global(ol) { margin: 0 0 16px; padding-left: 22px; }
  .content :global(li p) { margin: 0 0 4px; }
  .content :global(figure) { margin: 24px 0; }
  .content :global(img) { width: 100%; height: auto; }
  .content :global(figcaption) { font-size: 13px; color: var(--muted); margin-top: 6px; }
  .content :global(a) { color: var(--gold); text-decoration: underline; }
  .content :global(blockquote) { margin: 20px 0; padding-left: 16px; border-left: 3px solid var(--gold); font-style: italic; }
  .content :global(.table-wrap) { overflow-x: auto; }
  .content :global(table) { border-collapse: collapse; width: 100%; font-size: 14px; }
  .content :global(td) { border: 1px solid var(--line); padding: 6px 10px; vertical-align: top; }
  .tags { margin: 24px 0 0; display: flex; gap: 12px; font-size: 12px; }
  .tags a { text-decoration: underline; }
  .share { display: flex; gap: 16px; list-style: none; margin: 20px 0 0; padding: 16px 0 0; border-top: 1px solid var(--line); font-size: 13px; }
  .recent { padding: 30px 16px 80px; max-width: 980px; }
  .recent-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; }
  .recent-head h2 { font-family: var(--font-body); font-weight: 400; font-size: 16px; }
  .recent-head a { font-size: 13px; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } h1 { font-size: 26px; } }
</style>
