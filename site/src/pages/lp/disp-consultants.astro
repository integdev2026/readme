---
// Google Ads landing page for DISP (Defence Industry Security Program) membership.
// noindex, left out of the sitemap (astro.config.mjs) and not linked from the site.
// Same layout and booking pop-up as /lp/iso-consultants; shared styles in src/styles/landing.css.
// DISP rules (docs/OPEN-ITEMS.md): no ISO standards, no company stats, no prices, integPRO's own wording.
// Levels, classifications, timelines, categories, industries, process and FAQ come from src/data/disp.ts,
// so this page always says the same as /disp.
import Base from '../../layouts/Base.astro';
import '../../styles/landing.css';
import { categories, ladder, levels, industries, processSteps, faq as dispFaq } from '../../data/disp';

// Short excerpts from owner-supplied Google reviews, in the reviewers' own words: cuts marked with "…",
// other businesses' names left out so only integPRO is named, obvious typos corrected and "Integro"
// shown as "Integpro". Reviewer shown as first name + initial. Owner chose to include ISO reviews here.
const googleReviews = [
  { name: 'Emily P.', text: 'We have had an excellent experience working with the Integpro team… extremely thorough, knowledgeable, and responsive throughout the entire process.' },
  { name: 'Andrew R.', text: 'From our first call to the Stage 2 audit, Maria and Mehrdad at IntegPro were outstanding… We would recommend IntegPro… to any business seeking an effective and sustainable Integrated Management System.' },
  { name: 'Matthew B.', text: 'Our experience with Integpro was second to none. They were insightful, accommodating, knowledgeable, and worked with us to achieve the desired result.' },
  { name: 'Harry D.', text: 'We’ve had a great experience working with the Integpro team… professional, knowledgeable and very supportive throughout the process… Highly recommended.' },
  { name: 'Jayesh', text: 'Right from the start, their team showed a practical understanding of our specialised construction work… our certification was a success.' },
  { name: 'Harry F.', text: 'Massive thanks to IntegPro team, for professional consultations and leading us through the process of IMS accreditation for our company.' },
];

const icon = (id: string) => `/images/disp/icon-${id}.webp`;
const img = (p: string) => `/images/${p}`;
const levelText = [levels[0].short, levels[1].short, 'For businesses handling SECRET information on classified programs.', 'For businesses handling TOP SECRET information on classified programs.'];
const lvIcons = [`<path d="M12 2.5 4 5.5v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10v-6z"/>`, `<path d="M12 2.5 4 5.5v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10v-6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>`, `<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.3"/>`, `<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><path d="M9 15.5h6M9 18h6"/>`];
const levelCards = ladder.map((l, i) => ({ ...l, badge: i === 0 ? 'Entry' : `L${i}`, text: levelText[i] }));
const values = [
  { icon: 'icon-team', title: 'Security Officer support', text: 'We brief your Chief Security Officer and Security Officer and help them run the program.' },
  { icon: 'icon-shield', title: 'Cyber uplift, made practical', text: 'Essential Eight controls turned into a clear plan your IT team or provider can deliver.' },
  { icon: 'icon-checkbox', title: 'Application to assessment', text: "We prepare your application and help you answer Defence's questions." },
  { icon: 'icon-book', title: 'Support after membership', text: 'Annual security report, change reporting and keeping your controls in place.' },
];
const faqQuestions = ['Which DISP level do I need?', 'How long does it take?', 'Does DISP membership cost anything?', 'What are the CSO and SO roles?', 'Does DISP membership guarantee Defence contracts?'];
const faqs = faqQuestions.map((q) => dispFaq.find((f) => f.q === q)).filter((f) => !!f);
const phone = '1300 60 50 22';
const tel = 'tel:1300605022';
---
<Base
  bare
  noindex
  title="DISP Consultants Australia-wide | Defence Supply Chain | integPRO"
  description="Full DISP membership consultation for the Defence supply chain across Australia, from Entry Level to Level 3. Book a free consultation."
>
  <header class="lp-head">
    <div class="wrap">
      <a href="/" target="_blank" rel="noopener" class="lp-logo"><img src="/images/logo.webp" alt="integPRO" width="135" height="34" /></a>
      <div class="hact">
        <div class="tel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
          <a href={tel} aria-label={`Call ${phone}`}>{phone}</a>
          <span class="sep" aria-hidden="true"></span>
          <a href="tel:+61290804633" aria-label="Call 02 9080 4633">02 9080 4633</a>
        </div>
        <a class="btn-lp gold hbook" href="#book" data-open>Book free consultation</a>
      </div>
    </div>
  </header>

  <section class="hero disp-hero">
    <div class="wrap">
      <div class="intro">
        <span class="eyebrow">Defence Industry Security Program</span>
        <h1><span class="gold-t">DISP Membership</span> Full Consultation for the Defence Supply Chain</h1>
        <p class="lead">We get your business ready for DISP membership, from first gap analysis to a submitted application, and support you after it.</p>
      </div>
      <div class="more">
        <ul class="ticks">
          <li>Entry Level to Level 3, scoped to the information you handle</li>
          <li>Governance, personnel, physical and cyber security in one plan</li>
          <li>Free first conversation, then a clear scope of work</li>
        </ul>
        <div class="stats"><div><b>4</b><span>Security categories</span></div><div><b>EL to L3</b><span>DISP levels</span></div><div><b>Free</b><span>Consultation</span></div></div>
        <div class="team-chip"><img src="/images/team.webp" alt="The integPRO team" width="92" height="64" /><div><b>Your DISP consultants</b><span>The same team from gap analysis to membership</span></div></div>
      </div>
      <div class="book" id="book">
        <h2>Book a free consultation</h2>
        <p>Talk to a DISP consultant, Australia-wide. No obligation.</p>
        <ul class="ticks small">
          <li>Find out which DISP level you need</li>
          <li>Understand the steps and what's involved</li>
          <li>Get a clear scope and quote afterwards</li>
        </ul>
        <button type="button" class="btn-lp gold big" data-open>Choose a time &rsaquo;</button>
        <div class="or"><span>or call</span></div>
        <a class="callrow" href={tel}>{phone}</a>
        <a class="callrow" href="tel:+61290804633">02 9080 4633</a>
      </div>
    </div>
  </section>

  <section class="sec lv-sec">
    <div class="wrap">
      <div class="head"><h2>Which DISP level do you need?</h2><p>Security requirements step up with the classification of the information you handle. Not sure? That's what the free consultation is for.</p></div>
      <div class="lvls">
        {levelCards.map((l, i) => (
          <a class="lvl" href="#book" data-open>
            <span class="lv-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={lvIcons[i]} /></span>
            <span class="lv-n">{l.badge}</span>
            <h3>{l.label}</h3>
            <span class="cls">{l.classification}</span>
            <span class="meter" role="img" aria-label={`Security requirements: ${i + 1} of 4`}>{[0, 1, 2, 3].map((n) => <i class={n <= i ? 'on' : ''}></i>)}</span>
            <p>{l.text}</p>
            <span class="tl">Typical timeline: <b>{l.timeline}</b></span>
          </a>
        ))}
      </div>
      <p class="note">Most suppliers start with Entry Level. Levels 2 and 3 are always scoped as custom programs. Membership is assessed and granted by Defence.</p>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="head"><h2>What DISP membership covers</h2><p>Members show Defence they meet its security standards in four categories.</p></div>
      <div class="cats">
        {categories.map((c) => (
          <div class="cat"><img src={icon(c.icon)} alt="" width="48" height="48" loading="lazy" /><h3>{c.title}</h3><p>{c.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><h2>Who we help</h2><p>Businesses supplying Defence and its primes.</p></div>
      <div class="stds four">
        {industries.map((d) => (
          <a class="std" href="#book" data-open>
            <div class="ph" style={`background-image:url('${d.image?.src}')`} role="img" aria-label={d.image?.alt}></div>
            <div class="bd"><h3>{d.label}</h3><p>{d.level}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="head"><h2>How it works</h2></div>
      <ol class="steps six">
        {processSteps.map((s, i) => (
          <li class="step"><span class="num">{i + 1}</span><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
      <p class="note">Membership is granted by Defence after its own assessment. We prepare you and support you through it.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap value">
      <img src="/images/partner-collage.webp" alt="integPRO consultants working with clients" width="1080" height="1021" loading="lazy" />
      <div>
        <h2>Why Defence suppliers choose <span class="gold-t">integPRO</span></h2>
        <ul class="vlist">
          {values.map((v) => (
            <li><img src={img(`iso-disp-services/${v.icon}.webp`)} alt="" width="42" height="42" loading="lazy" /><div><b>{v.title}</b><span>{v.text}</span></div></li>
          ))}
        </ul>
        <a class="btn-lp gold" href="#book" data-open>Book free consultation</a>
      </div>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="ghead">
        <span class="gbadge"><svg class="g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.7 13.3l7.9 6.1C12.5 13.6 17.8 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 7l7.5 5.8c4.4-4 6.8-10 6.8-17.3z"/><path fill="#FBBC05" d="M10.6 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.1C1 16.6 0 20.2 0 24s1 7.4 2.7 10.7l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.8 2.3-8.4 2.3-6.2 0-11.5-4.1-13.4-9.9l-7.9 6.1C6.6 42.6 14.6 48 24 48z"/></svg></span>
        <h2>What our clients say</h2>
        <div class="grating">
          <span class="gstars" aria-label="5 out of 5 stars">★★★★★</span>
          <span class="gdiv" aria-hidden="true"></span>
          <span>Five-star reviews on <b>Google</b></span>
        </div>
      </div>
      <div class="gcards">
        {googleReviews.map((r) => (
          <figure class="gcard" aria-label={`Google review by ${r.name}`}>
            <div class="gtop"><span class="gstars sm" aria-label="5 out of 5 stars">★★★★★</span><b class="gname">{r.name}</b><svg class="g sm" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.7 13.3l7.9 6.1C12.5 13.6 17.8 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 7l7.5 5.8c4.4-4 6.8-10 6.8-17.3z"/><path fill="#FBBC05" d="M10.6 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.1C1 16.6 0 20.2 0 24s1 7.4 2.7 10.7l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.8 2.3-8.4 2.3-6.2 0-11.5-4.1-13.4-9.9l-7.9 6.1C6.6 42.6 14.6 48 24 48z"/></svg></div>
            <blockquote>"{r.text}"</blockquote>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><h2>Common questions</h2></div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}><summary>{f!.q}</summary><p>{f!.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Ready to start your DISP membership?</h2>
      <p>Book a free consultation with our DISP team, Australia-wide.</p>
      <a class="btn-lp gold" href="#book" data-open>Book free consultation</a>
      <a class="btn-lp ghost" href={tel}>Call {phone}</a>
    </div>
  </section>

  <footer class="lp-foot">
    <div class="wrap">
      integPRO Pty Ltd · ABN 23 633 745 516 · Level 35/252 Pitt St, Sydney NSW 2000 · <a href="mailto:info@integpro.com.au">info@integpro.com.au</a><br />
      <a href="/disp" target="_blank" rel="noopener">About DISP</a> · <a href="/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>
    </div>
  </footer>

  <div class="mbar">
    <a class="btn-lp ghost-d" href={tel}>Call</a>
    <a class="btn-lp gold" href="#book" data-open>Book a free consult</a>
  </div>

  <div class="modal" id="lp-modal" hidden>
    <div class="mbox" role="dialog" aria-modal="true" aria-label="Book a free consultation">
      <button type="button" class="mclose" data-close aria-label="Close">&times;</button>
      <h2>Choose a time</h2>
      <p>Free DISP consultation with integPRO. Pick a date and time below.</p>
      <!-- Booking widget (LeadConnector). form_embed.js resizes the iframe to its content. -->
      <div class="booking">
        <iframe data-src="https://api.leadconnectorhq.com/widget/booking/PtfPVxonsWeiroiaMa1y"
                style="width: 100%;border:none;overflow: hidden;" scrolling="no"
                id="PtfPVxonsWeiroiaMa1y_1761187771648"
                title="Book a consultation with integPRO"></iframe>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var m = document.getElementById('lp-modal');
      var f = m.querySelector('iframe');
      function open(e) {
        e.preventDefault();
        if (!f.getAttribute('src')) {
          f.setAttribute('src', f.getAttribute('data-src'));
          var s = document.createElement('script');
          s.src = 'https://link.msgsndr.com/js/form_embed.js';
          s.type = 'text/javascript';
          document.body.appendChild(s);
        }
        m.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function close() { m.hidden = true; document.body.style.overflow = ''; }
      document.querySelectorAll('[data-open]').forEach(function (el) { el.addEventListener('click', open); });
      m.addEventListener('click', function (e) { if (e.target === m || e.target.closest('[data-close]')) close(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
      // Phones: show the bottom Call/Book bar only once the booking card has scrolled out of view.
      var bar = document.querySelector('.mbar'), card = document.getElementById('book');
      if (bar && card && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (en) { bar.classList.toggle('show', !en[0].isIntersecting); }).observe(card);
      } else if (bar) { bar.classList.add('show'); }
    })();
  </script>
</Base>

<style>
  .disp-hero { background: linear-gradient(rgba(255,255,255,.9), rgba(255,255,255,.94)), url('/images/disp/eligibility.webp') center / cover; }
  .lv-sec { position: relative; background: linear-gradient(180deg, rgba(16,23,31,.86), rgba(25,35,51,.92)), url('/images/disp/levels-vault.webp') center 40% / cover; }
  .lv-sec .head h2 { color: #fff; }
  .lv-sec .head p { color: #cfd6e2; }
  .lv-sec .note { color: #aab4c4; }
  /* One baseline: bottoms and timeline rows line up; tops step up by making each card taller. */
  .lvls { align-items: end; }
  .lvl { box-shadow: 0 20px 50px rgba(0,0,0,.35); border-color: transparent; min-height: calc(var(--lv-base, 292px) + var(--lv-step, 0px)); }
  .lvl:nth-child(2) { --lv-step: 22px; }
  .lvl:nth-child(3) { --lv-step: 44px; }
  .lvl:nth-child(4) { --lv-step: 66px; }
  .lv-ic { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 12px; background: var(--gold-gradient); color: #fff; margin-bottom: 6px; box-shadow: 0 8px 18px rgba(150,130,68,.35); }
  .lvl:nth-child(4) .lv-ic { background: linear-gradient(135deg, #2b3a52, var(--navy)); box-shadow: 0 8px 18px rgba(25,35,51,.4); }
  .lv-ic svg { width: 24px; height: 24px; }
  .meter { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin: 6px 0 2px; }
  .meter i { height: 6px; border-radius: 3px; background: #ece7d8; }
  .meter i.on { background: var(--gold); }
  .lvl:nth-child(3) .meter i.on { background: var(--gold-dark); }
  .lvl:nth-child(4) .meter i.on { background: var(--navy); }
  .lvls { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .lvl { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 22px 20px; border: 1px solid var(--line); border-top: 5px solid var(--gold-light); border-radius: 18px; background: #fff; text-decoration: none; color: inherit; }
  .lvl:nth-child(2) { border-top-color: var(--gold); }
  .lvl:nth-child(3) { border-top-color: var(--gold-dark); }
  .lvl:nth-child(4) { border-top-color: var(--navy); }
  .lv-n { position: absolute; right: 16px; top: 16px; font-family: var(--font-heading); font-weight: 800; font-size: 13px; color: #fff; background: var(--gold-gradient); border-radius: 8px; padding: 4px 8px; }
  .lvl h3 { font-size: 18px; padding-right: 56px; }
  .cls { align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; color: var(--gold-dark); background: #f6f1e2; border-radius: 999px; padding: 4px 10px; }
  .lvl p { margin: 4px 0 0; font-size: 14px; color: var(--muted); flex: 1; }
  .tl { font-size: 13px; color: var(--muted); padding-top: 10px; border-top: 1px solid var(--line); }
  .tl b { color: var(--ink); }
  .cats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .cat { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 22px; }
  .cat img { width: 48px; height: 48px; display: block; margin-bottom: 12px; }
  .cat h3 { font-size: 16px; margin-bottom: 6px; }
  .cat p { margin: 0; font-size: 14px; }
  .stds.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .stds.four .ph { height: 140px; }
  .steps.six { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .steps.six .step { background: #fff; border: 1px solid var(--line); }
  .ghead { position: relative; text-align: center; max-width: 760px; margin: 0 auto 34px; padding: 34px 24px 28px; border-radius: 28px; background: radial-gradient(120% 140% at 50% 0%, #fff 0%, #fff 45%, #f6efdc 100%); border: 1px solid var(--gold-light); box-shadow: 0 24px 60px rgba(150,130,68,.14); }
  .gbadge { position: absolute; left: 50%; top: 0; transform: translate(-50%, -50%); width: 72px; height: 72px; display: grid; place-items: center; background: #fff; border-radius: 50%; box-shadow: 0 10px 28px rgba(0,0,0,.12); }
  .gbadge .g { width: 40px; height: 40px; }
  .ghead h2 { font-size: 32px; margin: 18px 0 14px; }
  .grating { display: inline-flex; align-items: center; gap: 14px; padding: 10px 22px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-size: 15px; color: var(--muted); }
  .grating b { color: var(--ink); }
  .grating .gstars { font-size: 24px; letter-spacing: 3px; text-shadow: 0 2px 10px rgba(251,188,5,.45); }
  .gdiv { width: 1px; height: 22px; background: linear-gradient(to bottom, transparent, var(--gold), transparent); }
  .gstars { color: #fbbc05; font-size: 28px; letter-spacing: 3px; line-height: 1.1; }
  .gstars.sm { font-size: 20px; letter-spacing: 2px; }
  .gcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; max-width: 1100px; margin: 0 auto; }
  .gcard { display: flex; flex-direction: column; }
  .gcard blockquote { flex: 1; }
  .gcard { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 26px 30px; }
  .gtop { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .gtop .g { margin-left: auto; flex: none; }
  .gname { color: var(--ink); font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gcard blockquote { margin-bottom: 0; }
  .g.sm { width: 26px; height: 26px; }
  .gcard blockquote { margin: 0; font-size: 15px; color: #222; line-height: 1.6; }
  .gcard blockquote p { margin: 0 0 10px; }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .lvl, .lv-n, .cat, .cat img { transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
    .lvl:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(0,0,0,.1); border-color: var(--gold); }
    .lvl:hover .lv-n { transform: scale(1.1); }
    .lvl:hover h3 { color: var(--gold-dark); }
    .cat:hover { transform: translateY(-5px); border-color: var(--gold-light); box-shadow: 0 14px 32px rgba(0,0,0,.08); }
    .cat:hover img { transform: scale(1.12) rotate(-4deg); }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .gcard { transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
    .gcard:hover { transform: translateY(-4px); border-color: var(--gold-light); box-shadow: 0 18px 40px rgba(0,0,0,.1); }
  }
