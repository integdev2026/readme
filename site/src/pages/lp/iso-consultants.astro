---
// Google Ads landing page for ISO (Sydney and Australia-wide ad groups).
// noindex, left out of the sitemap (astro.config.mjs) and not linked from the site.
// Every "Book" button opens the booking pop-up; the calendar loads only when it is opened.
// Booking embed: see docs/BOOKING-EMBED.md. Conversion: /thank-you sends booking_complete.
import Base from '../../layouts/Base.astro';
import '../../styles/landing.css';
import { getClientLogos, getTestimonials, type Testimonial } from '../../lib/wix';

// Client names, logos and testimonials stay in the Wix CMS (company policy), as on the home page.
const clientLogos = await getClientLogos();
const fallbackTestimonials: Testimonial[] = [
  { quote: 'The team at IntegPro have been incredibly helpful in managing our DISP requirements. As a small business, it can be challenging to stay on top of every obligation while juggling multiple roles, and their support has made a huge difference.', name: 'Client', role: 'OS of DISP' },
  { quote: 'From our first call to the Stage 2 audit, Maria and Mehrdad at IntegPro were outstanding. They combined deep expertise with practical guidance, were responsive and calm, and worked alongside our team to embed an Integrated Management System', name: 'Client', role: 'Security Director' },
];
const cms = await getTestimonials();
const testimonials = (cms.length ? cms : fallbackTestimonials).slice(0, 3);
const initials = (n: string) => n.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();

const img = (p: string) => `/images/${p}`;
const standards = [
  { n: '9001', title: 'Quality', text: 'Win tenders and deliver consistent quality.', photo: img('iso-9001-compliance-certification-sydney/hero-quality-meeting.webp') },
  { n: '14001', title: 'Environment', text: 'Manage environmental impact and compliance.', photo: img('iso-14001-compliance-certification/hero-seedling.webp') },
  { n: '45001', title: 'Health & Safety', text: 'Reduce workplace risk and protect your people.', photo: img('iso-45001-occupational-health-safety/hero-safety-manual.webp') },
  { n: '27001', title: 'Information Security', text: 'Protect data and meet client security demands.', photo: img('iso-27001-information-security-management-system/hero-data-centre.webp') },
  { n: '13485', title: 'Medical Devices', text: 'Quality system aligned with TGA expectations.', photo: img('iso-13485-medical-devices-quality-management-system/hero-exam-room.webp') },
];
const steps = [
  { icon: 'icon-team', title: 'Free consultation', text: 'We learn your goals and recommend the right standard.' },
  { icon: 'icon-search', title: 'Gap analysis', text: "A clear plan showing what's in place and what's missing." },
  { icon: 'icon-document', title: 'Build & implement', text: 'Practical documents, training and internal audit.' },
  { icon: 'icon-award', title: 'Certification audit', text: 'We prepare you and support you through the audit.' },
];
const values = [
  { icon: 'icon-checkbox', title: 'Practical, not paperwork', text: 'Systems that fit how your business already works.' },
  { icon: 'icon-team', title: 'One team, start to finish', text: 'The consultants you meet are the ones who see you through the audit.' },
  { icon: 'icon-book', title: 'Several standards, one system', text: 'Combine ISO 9001, 14001 and 45001 to save time and effort.' },
  { icon: 'icon-shield', title: 'DISP experience too', text: 'Useful if you supply, or plan to supply, Defence.' },
];
const faqs = [
  { q: 'Does integPRO issue the certificate?', a: 'No. An independent, accredited certification body issues it after its audit. We prepare you and support you through it.' },
  { q: 'How long does it take?', a: "It depends on your size, the standard and what's already in place. After the gap analysis we give you a realistic timeline." },
  { q: 'What does it cost?', a: "Two parts: our consulting and the certification body's audit fees. We give you a quote after the free consultation." },
  { q: 'Can we do more than one standard?', a: 'Yes. ISO 9001, 14001 and 45001 combine well into one integrated management system.' },
];
const phone = '1300 60 50 22';
const tel = 'tel:1300605022';
import IsoOffer from '../../components/offer/IsoOffer.astro';
import OfferBar from '../../components/offer/OfferBar.astro';
---
<Base
  bare
  noindex
  title="ISO Certification Consultants Sydney & Australia | integPRO"
  description="Sydney-based ISO consultants working with businesses across Australia. ISO 9001, 14001, 45001, 27001 and 13485. Book a free consultation."
>
  <OfferBar />
  <header class="lp-head">
    <div class="wrap">
      <a href="/" target="_blank" rel="noopener" class="lp-logo"><img src="/images/logo.webp" alt="integPRO ISO Consultant" width="135" height="34" /></a>
      <div class="hact">
        <div class="tel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
          <a href={tel} aria-label={`Call ${phone}`}>{phone}</a>
          <span class="sep" aria-hidden="true"></span>
          <a href="tel:+61290804633" aria-label="Call 02 9080 4633">02 9080 4633</a>
        </div>
        <a class="btn-lp gold hbook" href="#book" data-open>Book free consultation</a>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="wrap">
      <div class="intro">
        <span class="eyebrow">Sydney-based · Australia-wide</span>
        <h1><span class="gold-t">ISO Certification</span> Consultants in Sydney &amp; Across Australia</h1>
        <p class="lead">We build practical management systems and get your business ready for its certification audit.</p>
      </div>
      <div class="more">
        <ul class="ticks">
          <li>ISO 9001, 14001, 45001, 27001 and 13485, or combined in one integrated system</li>
          <li>From gap analysis to audit day, with one consultant team</li>
          <li>Free first conversation, then a clear quote</li>
        </ul>
        <div class="stats"><div><b>2019</b><span>Established</span></div><div><b>5</b><span>ISO standards</span></div><div><b>Free</b><span>Consultation</span></div></div>
        <div class="team-chip"><img src="/images/team.webp" alt="The integPRO team" width="92" height="64" /><div><b>Your Sydney consultants</b><span>The same team from first call to audit day</span></div></div>
      </div>
      <div class="book" id="book">
        <h2>Book a free consultation</h2>
        <p>Talk to a Sydney-based ISO consultant. No obligation.</p>
        <ul class="ticks small">
          <li>Find out which standard fits your business</li>
          <li>Understand the steps and what's involved</li>
          <li>Get a clear quote afterwards</li>
        </ul>
        <button type="button" class="btn-lp gold big" data-open>Choose a time &rsaquo;</button>
        <div class="or"><span>or call</span></div>
        <a class="callrow" href={tel}>{phone}</a>
        <a class="callrow" href="tel:+61290804633">02 9080 4633</a>
      </div>
    </div>
  </section>

  {clientLogos.length > 0 && (
    <div class="logos">
      <div class="wrap">
        <p>Trusted by businesses across Australia</p>
        <div class="logo-row">{clientLogos.map((c) => <img src={c.src} alt={c.name} height="40" loading="lazy" decoding="async" />)}</div>
      </div>
    </div>
  )}

  <IsoOffer openBooking />

  <section class="sec">
    <div class="wrap">
      <div class="head"><h2>Which standard do you need?</h2><p>Not sure? That's what the free consultation is for.</p></div>
      <div class="stds">
        {standards.map((s) => (
          <a class="std" href="#book" data-open>
            <div class="ph" style={`background-image:url('${s.photo}')`}><span class="n">{s.n}</span></div>
            <div class="bd"><h3>{s.title}</h3><p>{s.text}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="head"><h2>How it works</h2></div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step"><span class="num">{i + 1}</span><img src={img(`iso-disp-services/${s.icon}.webp`)} alt="" width="44" height="44" loading="lazy" /><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
      <p class="note">Certificates are issued by an independent, accredited certification body of your choice.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap value">
      <img src="/images/partner-collage.webp" alt="integPRO consultants working with clients" width="1080" height="1021" loading="lazy" />
      <div>
        <h2>Why businesses choose <span class="gold-t">integPRO</span></h2>
        <ul class="vlist">
          {values.map((v) => (
            <li><img src={img(`iso-disp-services/${v.icon}.webp`)} alt="" width="42" height="42" loading="lazy" /><div><b>{v.title}</b><span>{v.text}</span></div></li>
          ))}
        </ul>
        <a class="btn-lp gold" href="#book" data-open>Book free consultation</a>
      </div>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap">
      <div class="head"><h2>What our clients say</h2></div>
      <div class="quotes">
        {testimonials.map((t) => (
          <figure class="q">
            <div class="top"><span class="stars" aria-label="5 stars">★★★★★</span><img src="/images/icon-quote.webp" alt="" width="34" height="34" loading="lazy" /></div>
            <blockquote>"{t.quote}"</blockquote>
            <figcaption><span class="av">{initials(t.name)}</span><span><b>{t.name}</b><br />{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><h2>Common questions</h2></div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Ready to get started?</h2>
      <p>Book a free consultation with our Sydney-based team.</p>
      <a class="btn-lp gold" href="#book" data-open>Book free consultation</a>
      <a class="btn-lp ghost" href={tel}>Call {phone}</a>
    </div>
  </section>

  <footer class="lp-foot">
    <div class="wrap">
      integPRO Pty Ltd · ABN 23 633 745 516 · Level 35/252 Pitt St, Sydney NSW 2000 · <a href="mailto:info@integpro.com.au">info@integpro.com.au</a><br />
      <a href="/about-us-iso-team" target="_blank" rel="noopener">About us</a> · <a href="/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>
    </div>
  </footer>

  <div class="mbar">
    <a class="btn-lp ghost-d" href={tel}>Call</a>
    <a class="btn-lp gold" href="#book" data-open>Book a free consult</a>
  </div>

  <div class="modal" id="lp-modal" hidden>
    <div class="mbox" role="dialog" aria-modal="true" aria-label="Book a free consultation">
      <button type="button" class="mclose" data-close aria-label="Close">&times;</button>
      <h2>Choose a time</h2>
      <p>Free consultation with integPRO. Pick a date and time below.</p>
      <!-- Booking widget (LeadConnector). form_embed.js resizes the iframe to its content. -->
      <div class="booking">
        <iframe data-src="https://api.leadconnectorhq.com/widget/booking/PtfPVxonsWeiroiaMa1y"
                style="width: 100%;border:none;overflow: hidden;" scrolling="no"
                id="PtfPVxonsWeiroiaMa1y_1761187771648"
                title="Book a consultation with integPRO"></iframe>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var m = document.getElementById('lp-modal');
      var f = m.querySelector('iframe');
      function open(e) {
        e.preventDefault();
        if (!f.getAttribute('src')) {
          f.setAttribute('src', f.getAttribute('data-src'));
          var s = document.createElement('script');
          s.src = 'https://link.msgsndr.com/js/form_embed.js';
          s.type = 'text/javascript';
          document.body.appendChild(s);
        }
        m.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function close() { m.hidden = true; document.body.style.overflow = ''; }
      document.querySelectorAll('[data-open]').forEach(function (el) { el.addEventListener('click', open); });
      m.addEventListener('click', function (e) { if (e.target === m || e.target.closest('[data-close]')) close(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
      // Phones: show the bottom Call/Book bar only once the booking card has scrolled out of view.
      var bar = document.querySelector('.mbar'), card = document.getElementById('book');
      if (bar && card && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (en) { bar.classList.toggle('show', !en[0].isIntersecting); }).observe(card);
      } else if (bar) { bar.classList.add('show'); }
    })();
  </script>
</Base>
