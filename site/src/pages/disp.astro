---
import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import CenterHero from '../components/iso-service-australia/CenterHero.astro';
import ProcessSteps from '../components/iso-service-australia/ProcessSteps.astro';

const img = (id: string) => `/images/disp/icon-${id}.webp`;

const pillars = [
  { icon: '878bb3', title: 'Information Security' },
  { icon: '24d773', title: 'Physical Security' },
  { icon: '187f81', title: 'Personnel Security' },
  { icon: 'c67d3c', title: 'Documentation' },
];

// Level copy is verbatim from the live tabs (including the hidden Level 1–3 panels).
const levels = [
  {
    id: 'entry', label: 'Entry Level',
    lead: 'It\'s Suited to most businesses;',
    intro: 'We have developed a fixed-price package designed to bring companies into compliance with Entry Level DISP in a short time-frame.',
    paras: ['Compliance with Entry Level will grant access to OFFICIAL: Sensitive information.'],
    items: ['SO & CSO Selection & Training', 'Gap Analysis & Action Plan', 'Governance & Security Documentation', 'Physical & Cyber Security Support', 'Application & Interview Preparation', 'DoD Response & Compliance', 'Ongoing Support: Meetings, Maintenance, 3-Month Assistance'],
    whyTitle: 'Why Entry Level DISP?',
    why: ['DISP’s Entry Level or Baseline tier has been designed by the department to bring organisations to modern information security standards. Upon approval of your entry level application, your organisation will be cleared for up to and including Official: Sensitive Information.', 'In our experience, Entry level DISP is sufficient for the majority of companies in the supply chain.'],
  },
  {
    id: 'l1', label: 'Level 1',
    lead: 'Additional Inclusions, Compliance with Level 1 DISP',
    intro: 'requires an expanded scope to meet the department’s additional requirements. Generally the time, complexity and risk factors of implementation are increased. Compliance with Level 1 will grant access to PROTECTED information.',
    paras: [],
    items: ['Everything in Entry Level', 'Adjust Deliverables To: Level 1 Requirements', 'Additional Questioning in Gap Analysis', 'Further Provisions in Governance Documentation', 'Additional Cyber Security Policies', 'E8 Maturity Level Increased (Cyber)', 'Floor plan analysis, FOB & CCTV check', 'Action Plan Expanded'],
    whyTitle: 'Why Level 1 DISP?',
    why: ['DISP’s Level 1 tier has been designed by the department to bring organisations into compliance with strict information security standards. Upon approval of your level 1 application, your organisation will be cleared for up to and including Protected Information. Pricing for Level 1 DISP Consultancy is provided after the initial consult, where we develop your company risk profile and assess requirements further.', 'In our experience, Level 1 DISP is particularly suited to companies seeking self-sponsorship of security clearances.'],
  },
  {
    id: 'l2', label: 'Level 2',
    lead: 'Custom Package, Compliance with Level 2 DISP',
    intro: 'requires considerable expansion of project scope. Compliance with level 2 will grant access to SECRET information. The department has set high standards for Level 2 compliance across all four DISP categories.',
    paras: ['Level 2 is suited to organisations deeply embedded in the defence industry or working on highly classified projects.'],
    items: ['Everything in Entry Level, Level 1', 'Adjust Deliverables To: Level 2 Requirements', 'Mandatory Site Inspection'],
  },
  {
    id: 'l3', label: 'Level 3',
    lead: 'Custom Package, Compliance with Level 3 DISP',
    intro: 'requires significant expansion of project scope. Compliance with level 3 will grant access to TOP SECRET information.The department has set the highest standards for Level 3 compliance across all four DISP categories.',
    paras: ['Level 3 is suited to organisations involved in the most classified technologies, operations and defence works.'],
    items: ['Everything in Entry Level, Level 1, Level 2', 'Adjust Deliverables To: Level 3 Requirements'],
  },
];

const eligibility = [
  { k: 'Australian Presence:', v: 'Your business must operate in Australia and have an ABN.' },
  { k: 'Security Commitment:', v: 'Be ready to implement security policies and nominate responsible personnel.' },
  { k: 'Transparency:', v: 'Disclose ownership structure and any foreign influence.' },
];

const reasons = [
  { icon: '153f8b', title: 'Access Defence Contracts', text: 'Bid on classified defence contracts and expand your opportunities.' },
  { icon: '334a55', title: 'Competitive Advantage', text: 'Stand out as a trusted, security-cleared defence supplier.' },
  { icon: '24d773', title: 'Enhanced Security', text: 'Strengthen your security posture and protect business information.' },
];
---
<Base
  title="DISP Certification for Australian Defence Contractors | integPRO"
  description="DISP compliance for defence contractors. Expert guidance on Defence Industry Security Program. ISO 27001 + DISP integration. Win defence contracts confidently. Free consultation."
  noindex
>
  <CenterHero
    title='DISP Compliance for <span class="gold">Defence Contractors</span>'
    text="Expert guidance to achieve and maintain DISP compliance. Unlock defence contract opportunities across Australia."
    actions={[{ label: 'Get Started', href: '#contact' }]}
    stats={[{ value: '200+', label: 'Projects' }, { value: '5+', label: 'Years' }, { value: '100%', label: 'Success' }]}
  />

  <section class="section what">
    <div class="container">
      <div class="section-head">
        <h2>What is <span class="gold">DISP</span>?</h2>
        <p class="wide">The Defence Industry Security Program ensures contractors maintain appropriate security measures for classified information and defence contracts.</p>
      </div>
      <div class="mini-grid">
        {pillars.map((p) => (
          <article class="mini">
            <img src={img(p.icon)} alt="" width="48" height="48" loading="lazy" />
            <h3>{p.title}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section levels">
    <div class="container">
      <div class="section-head">
        <h2>Select Desired <span class="gold">DISP Level</span></h2>
      </div>
      <div class="tabs">
        {levels.map((l, i) => <input type="radio" name="disp-level" id={`lvl-${l.id}`} checked={i === 0} />)}
        <div class="tab-bar" role="tablist">
          {levels.map((l) => <label for={`lvl-${l.id}`} role="tab">{l.label}</label>)}
        </div>
        {levels.map((l) => (
          <div class={`tab-panel panel-${l.id}`} role="tabpanel">
            <p><span class="gold">{l.lead}</span> {l.intro}</p>
            {l.paras.map((p) => <p>{p}</p>)}
            <ul>{l.items.map((it) => <li>{it}</li>)}</ul>
            {l.whyTitle && (
              <p class="why-block"><span class="gold">{l.whyTitle}</span><br />{l.why![0]}</p>
            )}
            {l.why && l.why.slice(1).map((p) => <p>{p}</p>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="eligibility">
    <div class="container elig-grid">
      <div>
        <h2><span class="gold">DISP</span> Eligibility</h2>
        <p class="intro">We guide you through every requirement to achieve full DISP compliance and maintain your certification.</p>
        {eligibility.map((e) => <p><span class="gold">{e.k}</span> {e.v}</p>)}
      </div>
      <img src="/images/disp/eligibility.webp" alt="Jets flying in formation" width="588" height="472" loading="lazy" />
    </div>
  </section>

  <ProcessSteps sub="A straightforward approach to DISP compliance. Typical timeline: 4–6 months." />

  <section class="section reasons">
    <div class="container">
      <div class="section-head">
        <h2>Why <span class="gold">DISP</span> Compliance?</h2>
        <p class="wide">Open doors to the Australian defence industry and gain significant business advantages.</p>
      </div>
      <div class="card-grid">
        {reasons.map((r) => (
          <article class="card reason">
            <img src={img(r.icon)} alt="" width="48" height="48" loading="lazy" />
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactBand
    title='<span class="gold">Get Started</span>'
    sub="Book your free assessment for process validation, risk management, and QMS optimisation to strengthen compliance and operational performance."
    showDetails={false}
  />
</Base>

<style>
  .section-head .wide { max-width: 640px; }

  .what { background: var(--bg-faq); padding: 66px 0 96px; }
  .what .section-head { margin-bottom: 36px; }
  .mini-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .mini { display: grid; justify-items: center; gap: 22px; padding: 34px 16px 42px; background: #fff; border-radius: 16px; text-align: center; }
  .mini img { width: 48px; height: 48px; border-radius: 6px; }
  .mini h3 { font-family: var(--font-body); font-size: 15px; }

  .levels { padding: 56px 0 40px; }
  .levels .section-head { margin-bottom: 28px; }
  .tabs input { position: absolute; opacity: 0; pointer-events: none; }
  .tab-bar { display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; border-radius: 999px; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1); }
  .tab-bar label { height: 34px; display: grid; place-items: center; border-radius: 999px; cursor: pointer; font-family: var(--font-heading); font-size: 18px; color: var(--ink); }
  .tab-panel { display: none; padding: 60px 42px 20px; font-size: 15px; line-height: 1.5; }
  .tab-panel p { margin: 0 0 22px; }
  .tab-panel ul { margin: 0 0 22px; padding-left: 30px; }
  #lvl-entry:checked ~ .tab-bar label[for='lvl-entry'],
  #lvl-l1:checked ~ .tab-bar label[for='lvl-l1'],
  #lvl-l2:checked ~ .tab-bar label[for='lvl-l2'],
  #lvl-l3:checked ~ .tab-bar label[for='lvl-l3'] { background: var(--gold-gradient); }
  #lvl-entry:checked ~ .panel-entry,
  #lvl-l1:checked ~ .panel-l1,
  #lvl-l2:checked ~ .panel-l2,
  #lvl-l3:checked ~ .panel-l3 { display: block; }
  .tabs input:focus-visible ~ .tab-bar { outline: 2px solid var(--gold); outline-offset: 4px; }

  .eligibility { padding: 28px 0 72px; }
  .elig-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 588px); gap: 28px; align-items: center; }
  .elig-grid > * { min-width: 0; }
  .eligibility h2 { font-size: 40px; line-height: 1.3; }
  .eligibility p { margin: 20px 0 0; max-width: 350px; font-size: 15px; line-height: 1.5; }
  .eligibility .intro { margin-top: 10px; font-size: 16px; line-height: 1.5; }
  .eligibility img { width: 100%; aspect-ratio: 588 / 472; object-fit: cover; border-radius: 24px; }

  .reasons { padding-top: 64px; }
  .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; align-items: start; }
  .card { background: #fff; border-radius: var(--radius-card); box-shadow: var(--shadow-card); }
  .reason { display: grid; justify-items: center; padding: 28px 30px 70px; text-align: center; }
  .reason img { width: 48px; height: 48px; border-radius: 6px; }
  .reason h3 { margin-top: 18px; font-size: 20px; letter-spacing: 0.8px; }
  .reason p { margin: 18px 0 0; font-size: 14px; line-height: 1.45; }

  @media (max-width: 860px) {
    .mini-grid { grid-template-columns: 1fr 1fr; }
    .elig-grid { grid-template-columns: 1fr; }
    .eligibility p { max-width: none; }
  }
  @media (max-width: 760px) {
    .tab-bar label { font-size: 14px; }
    .tab-panel { padding: 32px 4px 8px; }
    .eligibility h2 { font-size: 30px; }
    .card-grid { grid-template-columns: 1fr; }
  }
</style>
