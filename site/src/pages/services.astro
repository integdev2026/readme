---
// Services hub: a signpost to the two separate services. The copy explains how we work and how the
// services differ; detailed ISO / DISP keyword targeting stays on /iso-service-australia and /disp.
import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import CenterHero from '../components/iso-service-australia/CenterHero.astro';
import Icon from '../components/Icon.astro';
import Chevron from '../components/Chevron.astro';
import Prose from '../components/disp/Prose.astro';

const howWeWork = [
  {
    h: 'How we work',
    p: [
      'Every engagement starts with a free consult and a gap analysis. We look at what you already do well, what the standard or program actually requires, and what your customers or contracts are asking for. From there you get a written scope with clear stages, so you know what the work involves before you commit.',
      'We build systems around how your business already operates. Policies and procedures are written for your people and your processes, not copied from a template, and we keep the paperwork to what you will actually use.',
    ],
  },
  {
    h: 'ISO certification and DISP membership are different',
    p: [
      'ISO certification is awarded by an independent certification body after an external audit against an international standard such as ISO 9001 or ISO 27001. It is usually driven by customers, tenders or regulators across many industries.',
      'DISP membership is granted by the Department of Defence. It covers the security of Defence information, people, premises and systems, and is driven by Defence contracts and primes. Some businesses need both. Holding one does not give you the other, although well-run management systems make the second easier to achieve.',
    ],
  },
  {
    h: 'What you can expect from us',
    list: [
      'Consultants with hands-on experience across quality, environment, safety, information security, medical devices and Defence security.',
      'A fixed scope and staged plan, with progress reviewed at regular check-ins.',
      'Support through the external audit or Defence assessment, including responses to findings or requests for information.',
      'Ongoing support after certification or membership, such as internal audits, management reviews and annual reporting.',
    ],
    p: [
      'We do not issue certificates or grant membership ourselves. Certification decisions are made by accredited certification bodies, and DISP decisions are made by Defence. Our job is to get you ready and support you through the process.',
    ],
  },
  {
    h: 'Who we work with',
    p: [
      'Our clients range from small family businesses to established organisations across Australia, in construction, manufacturing, engineering, healthcare and medical devices, IT and managed services, and Defence supply. Many run integrated management systems that cover several ISO standards at once, which reduces duplication and audit time.',
    ],
  },
];

const services = [
  {
    icon: 'check' as const,
    title: 'ISO Certification',
    text: 'Management system consulting from gap analysis to certification and beyond, for businesses that need to meet customer, tender or regulatory requirements.',
    chips: ['ISO 9001', 'ISO 14001', 'ISO 45001', 'ISO 27001', 'ISO 13485'],
    href: '/iso-service-australia',
    button: 'Explore ISO services',
  },
  {
    icon: 'shield' as const,
    title: 'DISP Membership',
    text: 'Preparing Australian businesses for the Defence Industry Security Program, from the first gap analysis to membership and ongoing obligations.',
    chips: ['Entry Level', 'Level 1', 'Level 2', 'Level 3'],
    href: '/disp',
    button: 'Explore DISP services',
  },
];

const chooser = [
  { q: 'A customer, tender or regulator is asking for ISO certification?', a: 'ISO Certification', href: '/iso-service-australia' },
  { q: 'You supply Defence or a Defence prime and need security clearance for information?', a: 'DISP Membership', href: '/disp' },
  { q: 'You want stronger quality, safety, environmental or information security systems?', a: 'ISO Certification', href: '/iso-service-australia' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'integPRO services',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@type': 'Service', name: s.title, url: new URL(s.href, Astro.site).href, provider: { '@type': 'ProfessionalService', name: 'integPRO' } },
  })),
};
---
<Base
  title="ISO & DISP Consulting Services in Australia | integPRO"
  description="integPRO, Sydney: two specialist services for businesses across Australia, ISO certification consulting and DISP membership support. Choose the one you need."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <CenterHero
    title='Our <span class="gold">Services</span>'
    text="Two specialist services, delivered separately. Choose the one your business needs."
  />

  <section class="section services">
    <div class="container cards">
      {services.map((s) => (
        <article class="card">
          <span class="icon"><Icon name={s.icon} size={30} /></span>
          <h2>{s.title}</h2>
          <p>{s.text}</p>
          <ul class="chips">{s.chips.map((c) => <li>{c}</li>)}</ul>
          <a class="btn btn-primary" href={s.href}>{s.button}<Chevron /></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section chooser-wrap">
    <div class="container">
      <div class="section-head">
        <h2>Not sure which <span class="gold">you need</span>?</h2>
      </div>
      <ul class="chooser">
        {chooser.map((c) => (
          <li>
            <p>{c.q}</p>
            <a href={c.href}>{c.a} ›</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Prose sections={howWeWork} />

  <ContactBand title='Talk to <span class="gold">Our Team</span>' sub="Not sure where to start? Book a free consult and we'll point you in the right direction." showDetails={false} />
</Base>

<style>
  .services { padding-top: 0; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .card { display: flex; flex-direction: column; gap: 16px; padding: 36px 32px; background: #fff; border-radius: var(--radius-card); box-shadow: var(--shadow-card); border-top: 5px solid var(--gold); }
  .icon { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 16px; background: var(--gold-gradient); color: #fff; }
  .card h2 { font-size: 28px; }
  .card p { margin: 0; font-size: 16px; line-height: 1.55; flex: 1; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .chips li { padding: 4px 12px; border-radius: 999px; background: var(--gold-light); color: var(--gold-dark); font-size: 13px; }
  .card .btn { align-self: flex-start; height: 44px; margin-top: 8px; }

  .chooser-wrap { background: var(--bg-faq); }
  .chooser { list-style: none; margin: 0 auto; padding: 0; max-width: 760px; display: grid; gap: 12px; }
  .chooser li { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 20px 24px; background: #fff; border-radius: 16px; }
  .chooser p { margin: 0; font-size: 15px; line-height: 1.5; }
  .chooser a { flex: none; color: var(--gold); font-weight: 700; font-size: 15px; }

  @media (max-width: 760px) {
    .cards { grid-template-columns: 1fr; }
    .card { padding: 28px 22px; }
    .card h2 { font-size: 24px; }
    .card .btn { align-self: stretch; justify-content: center; }
    .chooser li { flex-direction: column; align-items: flex-start; gap: 8px; }
  }
</style>
