---
// Booking confirmation. Point the LeadConnector booking widget's redirect here so Google Ads
// can count a booking as a conversion on this page view (set the trigger in Google Tag Manager).
import Base from '../layouts/Base.astro';
---
<Base title="Thank You | integPRO" description="Your consultation is booked." noindex>
  <section class="section">
    <div class="container" style="max-width: 680px; text-align: center; padding: 60px 16px;">
      <h1>Thank you, your consultation is booked</h1>
      <p>We've sent the details to your email. If you need to change the time, use the link in that email or call us.</p>
      <p><a class="btn btn-primary" href="/">Back to home</a></p>
    </div>
  </section>
  <!-- GA4 key event for a completed booking; mark "booking_complete" as a key event in GA4 and import it into Google Ads. -->
  <script is:inline>
    window.gtag && gtag('event', 'booking_complete');
  </script>
</Base>
