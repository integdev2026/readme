---
import Base from '../layouts/Base.astro';
import StandardPage from '../components/iso-standard-2/StandardPage.astro';
import { icon } from '../components/iso-standard-2/data';

const img = '/images/iso-27001-information-security-management-system';

const hero = {
  title: 'Achieve <span class="gold">ISO 27001</span> Certification',
  text: 'Build a robust Information Security Management System (ISMS) that protects sensitive information, reduces security risks, and strengthens stakeholder confidence.',
  // Tick wording copied verbatim from the live page.
  ticks: [
    'End-to-End ISO 27001 Implementation Support',
    'Internal Audit & Certification Readiness Success Rate',
    'Internal Audit & Certification Readiness',
  ],
  image: `${img}/hero-data-centre.webp`,
  imageAlt: 'Data centre corridor with server racks and information security overlays',
  learnHref: '#learnmore',
};

const intro = {
  id: 'learnmore',
  eyebrow: 'THE GLOBAL STANDARD',
  title: 'What is ISO 27001?',
  features: [
    { icon: icon('icon-globe'), title: 'Globally Recognised', text: 'Accepted worldwide as the leading standard for information security management.' },
    { icon: icon('icon-trend'), title: 'Risk-Based Approach', text: 'Identify, assess, and treat information security risks through structured controls and governance.' },
    { icon: icon('icon-clipboard'), title: 'Continuous Improvement', text: 'Monitor, review, and enhance your ISMS to address evolving threats and business needs.' },
    { icon: icon('icon-people'), title: 'Customer-Focused', text: 'Protect sensitive information and demonstrate security assurance to customers and stakeholders.' },
  ],
};

const details = {
  title: 'What <span class="gold">You Get</span>?',
  sub: "Everything you need to achieve and maintain ISO 27001 certification, tailored to your organization's information security requirements.",
  pill: 'ALL DOCUMENTATION CUSTOMIZED TO YOUR INDUSTRY AND BUSINESS NEEDS',
  cards: [
    { icon: icon('icon-trend'), title: 'Gap Analysis Report', text: 'A comprehensive assessment of your current information security practices against ISO 27001 requirements.', bullets: ['Current security controls review', 'Compliance gap identification', 'Risk prioritization roadmap', 'ISMS implementation plan'] },
    { icon: icon('icon-people'), title: 'ISO 27001 Documentation', text: 'Complete Information Security Management System (ISMS) documentation tailored to your business.', bullets: ['Information Security Policy', 'ISMS scope and context', 'Risk Assessment & Risk Treatment Methodology', 'Required procedures'] },
    { icon: icon('icon-award'), title: 'Risk Management', text: 'A structured framework to identify, assess, and manage information security risks.', bullets: ['Risk assessment register', 'Risk treatment plan', 'Statement of Applicability (SoA)', 'Annex A security controls implementation'] },
    { icon: icon('icon-check'), title: 'Internal Audit', text: 'Ensure your ISMS is effective and ready for certification.', bullets: ['Internal audit program', 'Audit reports and findings', 'Corrective action management', 'Management review support'] },
    { icon: icon('icon-target'), title: 'Staff Awareness', text: 'Build a security-conscious culture across your organization.', bullets: ['Security awareness training', 'Roles and responsibilities guidance', 'Incident reporting procedures', 'Best-practice security education'] },
  ],
};

const why = {
  title: 'Why <span class="gold">Your Business</span> Needs ISO 27001?',
  sub: 'Protect your organization from evolving cyber threats, meet customer expectations, and demonstrate a proactive commitment to information security with ISO 27001 certification.',
  features: [
    { icon: icon('icon-globe'), title: 'Win More Tenders', text: 'Many government agencies and large organizations require ISO 27001 certification as part of supplier qualification and procurement processes.' },
    { icon: icon('icon-lock'), title: 'Build Customer Trust', text: 'Demonstrate that your organization protects sensitive information using internationally recognized security best practices.' },
    { icon: icon('icon-trend'), title: 'Strengthen Cybersecurity', text: 'Identify, manage, and reduce information security risks through a structured and risk-based approach.' },
    { icon: icon('icon-bank'), title: 'Regulatory Requirements', text: 'Support compliance with privacy, contractual, and industry-specific information security obligations.' },
    { icon: icon('icon-people'), title: 'Improve Risk Management', text: 'Establish processes to assess, monitor, and treat information security risks before they impact your business.' },
    { icon: icon('icon-search'), title: 'Protect Business Data', text: 'Safeguard confidential data, intellectual property, customer information, and critical business systems from threats and breaches.' },
  ],
};

const industries = {
  title: 'ISO 27001 Across <span class="gold">Industries</span>',
  sub: 'Our consultants have extensive experience implementing ISO 27001 Information Security Management Systems (ISMS) across a wide range of industries, ensuring sector-specific security, compliance, and risk management requirements are met.',
  cards: [
    { icon: icon('ind-defence'), title: 'Defence', text: 'Support information security requirements for defence contractors and supply chains.', bullets: ['Support DISP and related compliance frameworks'] },
    { icon: icon('ind-manufacturing'), title: 'Manufacturing', text: 'Protect intellectual property, operational technology, and supply chain information from cyber threats.', bullets: ['Secure production systems and processes'] },
    { icon: icon('ind-construction'), title: 'Construction', text: 'Protect project data, contracts, and stakeholder information throughout the project lifecycle.', bullets: ['Meet government and client requirements'] },
    { icon: icon('ind-healthcare'), title: 'Healthcare', text: 'Protect sensitive patient information and support compliance with healthcare privacy and security requirements.', bullets: ['Secure medical records and patient data'] },
    { icon: icon('ind-professional'), title: 'Professional Services', text: 'Safeguard confidential client information and strengthen business credibility.', bullets: ['Protect sensitive business data'] },
    { icon: icon('ind-technology'), title: 'Technology & SaaS', text: 'Demonstrate robust security controls to customers, investors, and partners.', bullets: ['Accelerate sales and procurement approvals'] },
  ],
};

const cta = {
  title: 'Not sure if ISO 27001 applies to your industry?',
  paragraphs: ['ISO 27001 is universally applicable across all sectors and organization sizes. Our experts will help you understand the specific benefits and requirements for your business.'],
};
---
<Base
  title="ISO 27001 Compliance & Information | Integpro"
  description="ISO 27001 certification services in Australia. Implement an Information Security Management System (ISMS), improve cybersecurity, and protect business information."
  noindex
>
  <StandardPage hero={hero} intro={intro} details={details} why={why} industries={industries} cta={cta}>
    <p>ISO 27001:2022 is the internationally recognized standard for Information Security Management Systems (ISMS). It provides a structured framework for identifying, managing, and reducing information security risks while protecting the confidentiality, integrity, and availability of business information.</p>
    <p>The standard helps organizations establish effective security controls, manage cyber threats, and demonstrate compliance with customer, regulatory, and contractual requirements. ISO 27001 can be applied to organizations of all sizes and industries.</p>
    <p>By adopting a risk-based approach, ISO 27001 enables businesses to protect sensitive data, strengthen resilience against security incidents, and build trust with customers, partners, and stakeholders.</p>
  </StandardPage>
</Base>
