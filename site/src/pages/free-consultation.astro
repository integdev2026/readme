---
import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import { company, social } from '../data/site';

const mapQuery = encodeURIComponent('Parkline Place, Level 35/252 Pitt St, Sydney NSW 2000');
---
<Base
  title="Contact Us | Free Business Consultation for ISO Certification - integPRO"
  description="Discover expert ISO consulting and auditing services at integPRO. Book your free business consultation today to achieve ISO certification!"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>ISO &amp; DISP<br />Free Consultation</h1>
        <h2>Our Experts Supporting Businesses Across Sydney &amp; Australia</h2>
        <p>Connect with our team to discuss your business needs and discover how our tailored ISO certification and DISP compliance solutions can help you meet regulatory standards, enhance operational performance, and grow confidently in Australia’s competitive landscape.</p>
      </div>
      <div class="ring">
        <img class="ring-bg" src="/images/free-consultation/brand-ring.webp" alt="integpro brand sign" width="367" height="367" fetchpriority="high" />
        <img class="ring-icon" src="/images/free-consultation/contact-icon.webp" alt="contact iso experts australia" width="100" height="100" />
      </div>
    </div>
  </section>

  <!-- The live Wix form did not render in capture; the shared enquiry form stands in for it. -->
  <ContactBand showDetails={false} />

  <!-- Contact details -->
  <section class="details-wrap">
    <div class="container">
      <div class="details">
        <dl>
          <div class="row">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z" /><circle cx="12" cy="10" r="2.5" /></svg>
            <div><dt>Address:</dt><dd><b>Sydney:</b> Parkline Place, Level 35/252 Pitt St, Sydney NSW 2000</dd></div>
          </div>
          <div class="row">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h3l2 5-2.5 1.5a11 11 0 0 0 7 7L16 14l5 2v3a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z" /></svg>
            <div><dt>Phone:</dt><dd><a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phone}</a></dd></div>
          </div>
          <div class="row">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
            <div><dt>Email:</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
          </div>
        </dl>
        <ul class="social">
          {social.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><img src={s.icon} alt="" width="32" height="32" loading="lazy" /></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Map (the live page embeds a Google Map of the Sydney office) -->
  <section class="map">
    <iframe
      title="integPRO Sydney office map"
      src={`https://maps.google.com/maps?q=${mapQuery}&z=15&output=embed`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>
</Base>

<style>
  .hero { padding: 48px 0 40px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 367px; gap: 60px; align-items: start; }
  .hero-grid > * { min-width: 0; }
  h1 { font-size: 55px; line-height: 61px; color: var(--gold); }
  h2 { margin-top: 4px; max-width: 460px; font-size: 32px; line-height: 35px; color: var(--text); }
  .hero p { margin: 32px 0 0; max-width: 545px; font-size: 15px; line-height: 22.4px; color: #000; }
  .ring { position: relative; margin-top: 0; }
  .ring-bg { width: 100%; }
  .ring-icon { position: absolute; left: 50%; top: 50%; width: 100px; transform: translate(-50%, -50%); }

  .details-wrap { padding: 80px 0 60px; }
  .details { padding: 36px 36px 48px; background: #fff; border-radius: 16px; box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08); }
  dl { display: grid; gap: 16px; margin: 0; }
  .row { display: flex; gap: 8px; align-items: flex-start; }
  svg { flex: none; width: 32px; height: 32px; fill: none; stroke: #4b5320; stroke-width: 1.4; stroke-linejoin: round; }
  dt { font-family: var(--font-heading); font-weight: 700; font-size: 20px; line-height: 28px; color: var(--gold); letter-spacing: 0.5px; }
  dd { margin: 2px 0 0; font-size: 16px; color: var(--text); }
  dd b { color: var(--text); }
  .row:first-child dd { font-size: 15px; }
  .social { display: flex; justify-content: center; gap: 34px; width: max-content; max-width: 100%; margin: 24px auto 0; padding: 14px 38px; list-style: none; background: #fff; border-radius: 16px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); }
  .social img { width: 32px; height: 32px; filter: invert(1); }

  .map iframe { display: block; width: 100%; height: 450px; border: 0; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: 32px; }
    .ring { width: min(300px, 80%); margin: 0 auto; }
  }
  @media (max-width: 760px) {
    h1 { font-size: 38px; line-height: 44px; }
    h2 { font-size: 24px; line-height: 30px; }
    .details { padding: 24px 20px 32px; }
    .social { gap: 22px; padding: 12px 24px; }
    .map iframe { height: 320px; }
  }
</style>
