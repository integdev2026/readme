---
import BlogListing from '../../components/blog/BlogListing.astro';
import { getCategories, getPosts, POSTS_PER_PAGE, BLOG_CACHE_CONTROL } from '../../lib/wix';

Astro.response.headers.set('Cache-Control', BLOG_CACHE_CONTROL);

const [posts, categories] = await Promise.all([getPosts(), getCategories()]);
---
<BlogListing
  title="Explore What is ISO with IntegPRO | Academic Insights and Strategies"
  description="Practical guides on ISO certification and DISP membership for Australian businesses, from integPRO's Sydney-based consultants."
  heading="Discover ISO Tips & DISP Updates"
  posts={posts.slice(0, POSTS_PER_PAGE)}
  categories={categories}
  page={1}
  pages={Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE))}
  baseHref="/blog"
/>
