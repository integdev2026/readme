---
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { company, social, gtmId, gaId } from '../data/site';
import { orgId, websiteId, type Node, type PageType } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  pageType?: PageType;
  schema?: Node[];
  /** Landing pages: no site header, footer or mobile bar (the page supplies its own). */
  bare?: boolean;
}

const { title, description, noindex = false, pageType = 'WebPage', schema = [], bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
// Business details for search engines.
const site = Astro.site!;
const business = {
  '@type': 'ProfessionalService',
  '@id': orgId(site),
  name: company.name,
  legalName: 'integPRO Pty Ltd',
  url: Astro.site?.href,
  logo: new URL('/images/logo.png', Astro.site).href,
  telephone: company.phone,
  email: company.email,
  foundingDate: company.founded,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Level 35, 252 Pitt St',
    addressLocality: 'Sydney',
    addressRegion: 'NSW',
    postalCode: '2000',
    addressCountry: 'AU',
  },
  areaServed: { '@type': 'Country', name: 'Australia' },
  sameAs: social.map((s) => s.href),
};
const website = { '@type': 'WebSite', '@id': websiteId(site), url: site.href, name: company.name, inLanguage: 'en-AU', publisher: { '@id': orgId(site) } };
const webpage = {
  '@type': pageType,
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: title,
  ...(description && { description }),
  inLanguage: 'en-AU',
  isPartOf: { '@id': websiteId(site) },
  about: { '@id': orgId(site) },
};
const graph = { '@context': 'https://schema.org', '@graph': [business, website, webpage, ...schema] };
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    {gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        window.dataLayer = window.dataLayer || [];
        (function (w, d, s, l, i) {
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
          j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
        // Pass booking widget (LeadConnector) messages to GTM so a booking can be used as a conversion trigger.
        window.addEventListener('message', function (e) {
          if (!/leadconnectorhq\.com|msgsndr\.com/.test(e.origin)) return;
          var d = e.data, name = Array.isArray(d) ? d[0] : d && (d.type || d.event);
          if (typeof name === 'string') window.dataLayer.push({ event: 'booking_widget', bookingWidgetMessage: name });
        });
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="eoaN_za6CafCb65fEkFJEnHfpLGlKQSHJGThzZjyKYk" />
    <meta name="msvalidate.01" content="D501A2F8421C443890A1B4745C901888" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <!-- Favicon: same Wix Media image as the live integpro.com.au site. -->
    <link rel="icon" sizes="192x192" type="image/png" href="https://static.wixstatic.com/media/6d9105_404148c071ca4a80ba6d6fbe08832d27~mv2.png/v1/fill/w_192,h_192,lg_1,usm_0.66_1.00_0.01/favicon.png" />
    <link rel="icon" sizes="32x32" type="image/png" href="https://static.wixstatic.com/media/6d9105_404148c071ca4a80ba6d6fbe08832d27~mv2.png/v1/fill/w_32,h_32,lg_1,usm_0.66_1.00_0.01/favicon.png" />
    <link rel="apple-touch-icon" href="https://static.wixstatic.com/media/6d9105_404148c071ca4a80ba6d6fbe08832d27~mv2.png/v1/fill/w_180,h_180,lg_1,usm_0.66_1.00_0.01/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body id="top">
    {gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" /></noscript>
    )}
    {!bare && <Header />}
    <main>
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <MobileBar />}
  </body>
</html>
