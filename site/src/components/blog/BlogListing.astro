---
// Shared listing layout for /blog, /blog/page/N and category pages (9 posts per page, like the live site).
import Base from '../../layouts/Base.astro';
import PostCard from './PostCard.astro';
import CategoryNav from './CategoryNav.astro';
import type { Category, Post } from '../../lib/wix';

interface Props {
  title: string;
  description: string;
  heading: string;
  posts: Post[];
  categories: Category[];
  activeCategory?: string;
  page: number;
  pages: number;
  baseHref: string;
}
const { title, description, heading, posts, categories, activeCategory, page, pages, baseHref } = Astro.props;
const href = (n: number) => (n === 1 ? baseHref : `${baseHref.replace(/\/$/, '')}/page/${n}`);
---
<Base title={title} description={description} noindex>
  <section class="blog">
    <div class="container">
      <h1>{heading}</h1>
      {!activeCategory && (
        <div class="intro">
          <p>At integPRO, we’re not just about certification, we’re about clarity, confidence, and continuous learning. That’s why we’ve launched <em>integPRO Insight</em>, a dedicated space where we share academic insights, practical guidance, explainer videos, and real-world case examples on all things ISO, compliance, risk, and management systems.</p>
          <p>Whether you're a business leader, compliance officer, or simply curious about how international standards shape industries like construction, defence, or healthcare, this is for you.</p>
        </div>
      )}
      <CategoryNav categories={categories} active={activeCategory} />
      {posts.length === 0 ? (
        <p class="empty">Posts are loading from Wix and will appear on the published site.</p>
      ) : (
        <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div>
      )}
      {pages > 1 && (
        <nav class="pager" aria-label="Pagination">
          {page > 1 && <a href={href(page - 1)} aria-label="Previous page">‹</a>}
          {Array.from({ length: pages }, (_, i) => i + 1).map((n) => (
            <a href={href(n)} class:list={{ current: n === page }} aria-current={n === page ? 'page' : undefined}>{n}</a>
          ))}
          {page < pages && <a href={href(page + 1)} aria-label="Next page">›</a>}
        </nav>
      )}
    </div>
  </section>
</Base>

<style>
  .blog { padding: 30px 0 80px; }
  h1 { font-size: 40px; color: var(--gold); margin-bottom: 16px; }
  .intro { padding: 20px 20px; border-radius: 12px; box-shadow: var(--shadow-card); font-size: 12px; line-height: 1.5; margin-bottom: 40px; }
  .intro p { margin: 0 0 12px; }
  .intro p:last-child { margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 20px; padding: 32px 20px 0; }
  .empty { padding: 40px 20px; color: var(--muted); }
  .pager { display: flex; justify-content: center; gap: 18px; margin-top: 48px; font-size: 14px; }
  .pager a { color: var(--text); }
  .pager a.current { color: var(--gold); font-weight: 700; }
  @media (max-width: 860px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; padding: 24px 0 0; } h1 { font-size: 30px; } }
</style>
