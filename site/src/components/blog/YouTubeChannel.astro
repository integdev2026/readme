---
// integPRO YouTube band on the first blog page: channel header + clickable video thumbnails that open YouTube.
// Thumbnails are plain images until clicked; a click swaps in the player and plays the video in the page.
// Without JavaScript the thumbnail is a normal link to the video on YouTube.
import { social } from '../../data/site';

const channel = social.find((s) => s.label === 'YouTube')!.href.replace(/\/$/, '');
const videos = ['raUfdWG3oRI', '4WB-NEOKMbM', '0VyygnZXwtk'];
const ytIcon = 'M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.7 15V9l5.8 3-5.8 3Z';
---
<section class="yt" aria-labelledby="yt-title">
  <div class="channel">
    <span class="logo" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path fill="currentColor" d={ytIcon} /></svg></span>
    <div class="text">
      <h2 id="yt-title">Watch integPRO on <span class="red">YouTube</span></h2>
      <p>Short explainer videos on ISO certification, DISP membership and management systems.</p>
    </div>
    <div class="actions">
      <a class="btn yt-sub" href={`${channel}?sub_confirmation=1`} target="_blank" rel="noopener">Subscribe</a>
      <a class="btn yt-visit" href={`${channel}/videos`} target="_blank" rel="noopener">All videos ›</a>
    </div>
  </div>
  <div class="videos">
    {videos.map((id, i) => (
      <a class="video" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener" data-yt={id} aria-label={`Play integPRO video ${i + 1}`}>
        <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" />
        <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="64" height="64"><path fill="#ff0000" d={ytIcon} /><path fill="#fff" d="M9.7 15V9l5.8 3-5.8 3Z" /></svg></span>
        <span class="label">Play video</span>
      </a>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-yt]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1&rel=0`;
      frame.title = a.getAttribute('aria-label') || 'integPRO video';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.allowFullscreen = true;
      frame.className = 'video';
      a.replaceWith(frame);
      frame.focus();
    });
  });
</script>

<style>
  .yt { margin: 0 0 36px; padding: 26px; background: #fff; border: 1px solid var(--line); border-radius: 16px; }
  .channel { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .logo { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: #fff0f0; color: #ff0000; flex: none; }
  .text { flex: 1; min-width: 220px; }
  .text h2 { margin: 0; font-size: 24px; color: var(--navy); }
  .red { color: #ff0000; }
  .text p { margin: 4px 0 0; font-size: 14px; color: var(--text); }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; justify-content: center; height: 42px; padding: 0 20px; border-radius: 999px; font-size: 14px; font-weight: 700; }
  .yt-sub { background: #ff0000; color: #fff; }
  .yt-sub:hover { background: #cc0000; }
  .yt-visit { border: 1px solid var(--line); color: var(--navy); }
  .yt-visit:hover { border-color: #ff0000; color: #cc0000; }
  .videos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 22px; }
  .video { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: var(--navy); }
  .videos :global(iframe) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 12px; background: var(--navy); }
  .video img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s; }
  .video::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.6) 100%); }
  .play { position: absolute; inset: 0; display: grid; place-items: center; z-index: 1; transition: transform 0.2s; }
  .label { position: absolute; left: 12px; bottom: 10px; z-index: 1; font-size: 12px; font-weight: 700; color: #fff; }
  .video:hover img { transform: scale(1.05); }
  .video:hover .play { transform: scale(1.1); }
  @media (max-width: 860px) { .videos { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; } .play svg { width: 44px; height: 44px; } .label { display: none; } }
  @media (max-width: 560px) {
    .yt { padding: 18px 14px; }
    .videos { grid-template-columns: 1fr; }
    .label { display: block; }
    .actions { width: 100%; }
    .actions .btn { flex: 1; }
  }
</style>
