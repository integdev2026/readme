---
// Beige band with a centred heading and a three-column grid of FeatureCards.
import Heading from './Heading.astro';
import FeatureCard from './FeatureCard.astro';
import type { Feature } from './shared';

interface Props { title: string; sub?: string; cards: Feature[] }
const { title, sub, cards } = Astro.props;
---
<section class="section band">
  <div class="container">
    <Heading title={title} sub={sub} />
    <div class="grid">{cards.map((c) => <FeatureCard {...c} />)}</div>
  </div>
</section>

<style>
  .band { padding: 24px 0 64px; background: #f0ebd9; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 26px; align-items: start; }
  @media (max-width: 860px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } .band { padding: 48px 0; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
