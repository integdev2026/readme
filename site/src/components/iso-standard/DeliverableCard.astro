---
// White rounded card with a centred icon and title, left-aligned text and optional bullets.
interface Props { icon: string; title: string; text: string; bullets?: string[] }
const { icon, title, text, bullets = [] } = Astro.props;
---
<article class="deliverable">
  <img src={icon} alt="" width="48" height="48" loading="lazy" />
  <h3>{title}</h3>
  <p>{text}</p>
  {bullets.length > 0 && <ul>{bullets.map((b) => <li>{b}</li>)}</ul>}
</article>

<style>
  .deliverable { min-width: 0; padding: 32px 30px 48px 45px; background: #fff; border-radius: 32px; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.07); }
  img { width: 48px; height: 48px; margin: 0 auto; border-radius: 6px; }
  h3 { margin: 18px -18px 12px -30px; text-align: center; font-size: 20px; line-height: 1.4; letter-spacing: 0.5px; }
  p { margin: 0; font-size: 14px; line-height: 1.42; color: var(--ink); }
  ul { margin: 19px 0 0; padding-left: 25px; font-size: 14px; line-height: 1.42; color: var(--ink); }
  @media (max-width: 560px) {
    .deliverable { padding: 28px 24px 32px; }
    h3 { margin-inline: 0; }
  }
</style>
