---
// Wrapper for every DISP page: section bar (breadcrumbs and DISP menu), page content and a DISP-specific booking band.
import Base from '../../layouts/Base.astro';
import ContactBand from '../ContactBand.astro';
import SectionBar from '../SectionBar.astro';
import { dispNav, type Crumb } from '../../data/disp';
import type { Node, PageType } from '../../lib/schema';

interface Props { title: string; description: string; crumbs: Crumb[]; pageType?: PageType; schema?: Node[] }
const { title, description, crumbs, pageType, schema } = Astro.props;
---
<Base title={title} description={description} pageType={pageType} schema={schema}>
  <SectionBar crumbs={crumbs} nav={dispNav} label="DISP section" />

  <slot />

  <ContactBand
    title='Book a <span class="gold">Free DISP Consult</span>'
    sub="Talk to us about your Defence contract requirements and which DISP level fits your business."
    showDetails={false}
  />
</Base>
