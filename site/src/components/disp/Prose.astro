---
// Long-form copy block for DISP and services pages, from src/data/disp-copy.ts. Each section is a
// numbered white card on the grey band, styled like the site's other cards (gold top border,
// gold-gradient badge, last words of the heading in gold). Lists render as gold-ticked grids.
import type { CopySection } from '../../data/disp-copy';

interface Props { sections: CopySection[] }
const { sections } = Astro.props;

// "Step 3: Implementation" -> eyebrow "Step 3", title "Implementation".
const split = (h: string) => {
  const m = h.match(/^(Step \d+):\s*(.+)$/);
  const eyebrow = m ? m[1] : undefined;
  const words = (m ? m[2] : h).split(' ');
  const n = words.length > 3 ? 2 : 1;
  return { eyebrow, lead: words.slice(0, -n).join(' '), gold: words.slice(-n).join(' ') };
};
---
<section class="section prose-wrap">
  <div class="container prose">
    {sections.map((s, i) => {
      const h = split(s.h);
      return (
        <article class="block">
          <span class="badge" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="body">
            {h.eyebrow && <span class="eyebrow">{h.eyebrow}</span>}
            <h2>{h.lead} <span class="gold">{h.gold}</span></h2>
            {s.p.map((p) => <p>{p}</p>)}
            {s.list && <ul class:list={{ cols: s.list.length > 4 }}>{s.list.map((li) => <li>{li}</li>)}</ul>}
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .prose-wrap { background: var(--bg-faq); }
  .prose { display: grid; gap: 20px; }
  .block { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 24px; padding: 36px 40px; background: #fff; border-radius: var(--radius-card); border-top: 4px solid var(--gold); box-shadow: var(--shadow-card); }
  .badge { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 18px; background: var(--gold-gradient); color: #fff; font-family: var(--font-heading); font-weight: 700; font-size: 22px; box-shadow: 0 6px 16px rgba(150, 130, 68, 0.3); }
  .eyebrow { display: block; margin-bottom: 6px; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: var(--gold-dark); }
  h2 { font-size: 28px; line-height: 1.3; margin-bottom: 14px; }
  p { margin: 0 0 14px; font-size: 16px; line-height: 1.65; }
  p:last-child { margin-bottom: 0; }
  ul { list-style: none; margin: 4px 0 14px; padding: 0; display: grid; gap: 10px; }
  ul:last-child { margin-bottom: 0; }
  ul.cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  li { position: relative; padding: 14px 16px 14px 46px; background: var(--bg-faq); border-radius: 14px; font-size: 15px; line-height: 1.5; }
  li::before { content: '✓'; position: absolute; left: 14px; top: 13px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--gold); color: #fff; font-size: 12px; font-weight: 700; }
  @media (max-width: 760px) {
    .block { grid-template-columns: 1fr; gap: 16px; padding: 28px 22px; }
    .badge { width: 52px; height: 52px; font-size: 18px; border-radius: 14px; }
    h2 { font-size: 23px; }
    p { font-size: 15px; }
    ul.cols { grid-template-columns: 1fr; }
  }
</style>
