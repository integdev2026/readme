---
// Long-form copy block for DISP pages: H2 sections of plain paragraphs, from src/data/disp-copy.ts.
import type { CopySection } from '../../data/disp-copy';

interface Props { sections: CopySection[]; grey?: boolean }
const { sections, grey = false } = Astro.props;
---
<section class:list={['section', 'prose-wrap', { grey }]}>
  <div class="container prose">
    {sections.map((s) => (
      <div class="block">
        <h2>{s.h}</h2>
        {s.p.map((p) => <p>{p}</p>)}
        {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
      </div>
    ))}
  </div>
</section>

<style>
  .grey { background: var(--bg-faq); }
  .prose { max-width: 820px; }
  .block + .block { margin-top: 44px; }
  .prose h2 { font-size: 28px; line-height: 1.3; margin-bottom: 14px; }
  .prose p { margin: 0 0 14px; font-size: 16px; line-height: 1.65; }
  .prose ul { margin: 0 0 14px; padding-left: 22px; display: grid; gap: 8px; font-size: 16px; line-height: 1.55; }
  @media (max-width: 760px) {
    .prose h2 { font-size: 23px; }
    .prose p, .prose ul { font-size: 15px; }
  }
</style>
