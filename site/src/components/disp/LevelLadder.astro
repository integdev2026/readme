---
// DISP level staircase: each step is one membership level, rising with the classification it covers.
import Icon from '../Icon.astro';
import { ladder } from '../../data/disp';
---
<div class="ladder" role="list">
  {ladder.map((s, i) => (
    <a class="step" href={s.href} role="listitem" style={`--i: ${i}`}>
      <span class="level">{s.label}</span>
      <span class="bar">
        <Icon name={i === 0 ? 'shield' : i === 3 ? 'lock' : 'shieldCheck'} size={26} />
        <span class="class">{s.classification}</span>
        <span class="time">{s.timeline}</span>
      </span>
    </a>
  ))}
</div>
<p class="ladder-note">Each level includes everything in the levels below it.</p>

<style>
  .ladder { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; align-items: end; }
  .step { display: flex; flex-direction: column; gap: 10px; text-align: center; transition: transform 0.2s; }
  .step:hover { transform: translateY(-4px); }
  .level { font-family: var(--font-heading); font-weight: 700; font-size: 17px; color: var(--ink); }
  .bar {
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 6px;
    height: calc(130px + var(--i) * 52px); padding: 24px 10px 18px; border-radius: 16px 16px 6px 6px; color: #fff;
  }
  .step:nth-child(1) .bar { background: var(--gold-light); color: var(--gold-dark); }
  .step:nth-child(2) .bar { background: var(--gold); }
  .step:nth-child(3) .bar { background: var(--gold-dark); }
  .step:nth-child(4) .bar { background: var(--navy); }
  .class { font-family: var(--font-heading); font-weight: 700; font-size: 15px; line-height: 1.25; }
  .time { font-size: 13px; opacity: 0.9; }
  .ladder-note { margin: 16px 0 0; text-align: center; font-size: 13px; color: var(--muted); }
  @media (max-width: 760px) {
    .ladder { grid-template-columns: 1fr; }
    .bar { height: auto; flex-direction: row; justify-content: space-between; padding: 14px 18px; border-radius: 12px; margin-left: calc(var(--i) * 14px); }
    .step { text-align: left; }
  }
</style>
