---
import { nav, cta } from '../data/site';
import Chevron from './Chevron.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string, children?: { href: string }[]) =>
  href === path || (href !== '/' && path.startsWith(href)) || (children ?? []).some((c) => path.startsWith(c.href));
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label="integPRO home">
      <img src="/images/logo.png" alt="integPRO ISO Consultant" width="135" height="34" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Open menu" />
    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>

    <nav class="menu" aria-label="Main">
      <ul>
        {nav.map((item, i) => (
          <li class:list={[{ 'has-children': item.children }]}>
            <a href={item.href} class:list={['menu-link', { active: isActive(item.href, item.children) }]}>{item.label}</a>
            {item.children && (
              <>
                <input type="checkbox" id={`sub-${i}`} class="sub-toggle" aria-label={`Show ${item.label} pages`} />
                <label for={`sub-${i}`} class="sub-open" aria-hidden="true"></label>
              </>
            )}
            {item.children && (
              <ul class="submenu">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a href={cta.href} class="btn btn-light cta">{cta.label}<Chevron /></a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: #fff; }
  .bar { height: 94px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .logo img { width: 135px; height: auto; }
  .menu { display: flex; align-items: center; gap: 48px; }
  .menu > ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .menu li { position: relative; }
  .menu-link {
    display: inline-flex; align-items: center; height: 38px; padding: 0 16px; border-radius: 999px;
    font-family: var(--font-heading); font-size: 14px; letter-spacing: 0.7px; color: var(--text);
    transition: background-color 0.2s;
  }
  .menu-link:hover, .menu-link.active { background: var(--gold-light); color: var(--ink); }
  .submenu {
    position: absolute; top: 100%; left: 0; min-width: 200px; list-style: none; margin: 0; padding: 8px;
    background: #fff; border-radius: 12px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: all 0.2s;
  }
  .has-children:hover .submenu, .has-children:focus-within .submenu { opacity: 1; visibility: visible; transform: none; }
  .submenu a { display: block; white-space: nowrap; padding: 8px 12px; border-radius: 8px; font-family: var(--font-heading); font-size: 14px; }
  .submenu a:hover { background: var(--gold-light); }
  .cta { height: 40px; font-size: 14px; letter-spacing: 1px; }
  .nav-toggle, .burger { display: none; }
  .menu-link, .cta { white-space: nowrap; }

  @media (max-width: 1180px) {
    .menu { gap: 16px; }
    .menu-link { padding: 0 10px; }
  }

  .sub-toggle, .sub-open { display: none; }

  /* Phones and tablets: slim header, burger turns into a close button, and a scrollable menu whose
     ISO and DISP sub-pages open on tap. */
  @media (max-width: 1000px) {
    .bar { height: 64px; }
    .logo img { width: 140px; }
    .burger { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px; width: 44px; height: 44px; cursor: pointer; }
    .burger span { display: block; width: 26px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
    .nav-toggle:checked + .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked + .burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked + .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .menu {
      position: absolute; top: 64px; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 16px;
      max-height: calc(100vh - 64px); overflow-y: auto; overscroll-behavior: contain;
      padding: 12px 16px 24px; background: #fff; box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12); display: none;
    }
    .nav-toggle:checked ~ .menu { display: flex; }
    .menu > ul { flex-direction: column; gap: 0; }
    .menu > ul > li { display: flex; flex-wrap: wrap; align-items: center; border-bottom: 1px solid var(--line); }
    .menu-link { flex: 1; height: 48px; padding: 0 12px; font-size: 16px; }
    .sub-open { display: grid; place-items: center; width: 48px; height: 48px; cursor: pointer; }
    .sub-open::after { content: ''; width: 9px; height: 9px; border-right: 2px solid var(--gold); border-bottom: 2px solid var(--gold); transform: rotate(45deg); transition: transform 0.2s; }
    .sub-toggle:checked + .sub-open::after { transform: rotate(-135deg); }
    .submenu { display: none; flex-basis: 100%; position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; padding: 0 0 8px 12px; }
    .sub-toggle:checked ~ .submenu { display: block; }
    .submenu a { display: flex; align-items: center; min-height: 44px; font-size: 15px; white-space: normal; }
    .cta { align-self: stretch; justify-content: center; height: 48px; font-size: 15px; }
  }
</style>
