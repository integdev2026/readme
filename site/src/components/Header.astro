---
import { nav, cta } from '../data/site';
import Chevron from './Chevron.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string, children?: { href: string }[]) =>
  href === path || (href !== '/' && path.startsWith(href)) || (children ?? []).some((c) => path.startsWith(c.href));
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label="integPRO home">
      <img src="/images/logo.png" alt="integPRO ISO Consultant" width="135" height="34" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Open menu" />
    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>

    <nav class="menu" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li class:list={[{ 'has-children': item.children }]}>
            <a href={item.href} class:list={['menu-link', { active: isActive(item.href, item.children) }]}>{item.label}</a>
            {item.children && (
              <ul class="submenu">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a href={cta.href} class="btn btn-light cta">{cta.label}<Chevron /></a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: #fff; }
  .bar { height: 94px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .logo img { width: 135px; height: auto; }
  .menu { display: flex; align-items: center; gap: 48px; }
  .menu > ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .menu li { position: relative; }
  .menu-link {
    display: inline-flex; align-items: center; height: 38px; padding: 0 16px; border-radius: 999px;
    font-family: var(--font-heading); font-size: 14px; letter-spacing: 0.7px; color: var(--text);
    transition: background-color 0.2s;
  }
  .menu-link:hover, .menu-link.active { background: var(--gold-light); color: var(--ink); }
  .submenu {
    position: absolute; top: 100%; left: 0; min-width: 200px; list-style: none; margin: 0; padding: 8px;
    background: #fff; border-radius: 12px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: all 0.2s;
  }
  .has-children:hover .submenu, .has-children:focus-within .submenu { opacity: 1; visibility: visible; transform: none; }
  .submenu a { display: block; padding: 8px 12px; border-radius: 8px; font-family: var(--font-heading); font-size: 14px; }
  .submenu a:hover { background: var(--gold-light); }
  .cta { height: 40px; font-size: 14px; letter-spacing: 1px; }
  .nav-toggle, .burger { display: none; }

  @media (max-width: 1000px) {
    .burger { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 40px; height: 40px; cursor: pointer; }
    .burger span { display: block; height: 2px; background: var(--ink); border-radius: 2px; }
    .menu {
      position: absolute; top: 94px; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 16px;
      padding: 16px; background: #fff; box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08); display: none;
    }
    .nav-toggle:checked ~ .menu { display: flex; }
    .menu > ul { flex-direction: column; }
    .submenu { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; padding: 0 0 0 16px; }
    .cta { align-self: flex-start; }
  }
</style>
