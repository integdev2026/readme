---
// White rounded card: centred icon and bold title, left-aligned text and optional bullets.
interface Props { icon: string; title: string; text: string; bullets?: string[] }
const { icon, title, text, bullets = [] } = Astro.props;
---
<article class="detail">
  <img src={icon} alt="" width="48" height="48" loading="lazy" />
  <h3>{title}</h3>
  <p>{text}</p>
  {bullets.length > 0 && <ul>{bullets.map((b) => <li>{b}</li>)}</ul>}
</article>

<style>
  .detail { min-width: 0; padding: 32px 28px 48px 44px; background: #fff; border-radius: 30px; box-shadow: 0 6px 22px rgba(0, 0, 0, 0.08); }
  img { width: 48px; height: 48px; margin: 0 auto 14px; border-radius: 4px; }
  h3 { margin: 0 auto 14px; max-width: 260px; text-align: center; font-size: 20px; line-height: 28px; letter-spacing: 0.5px; color: var(--ink); }
  p { margin: 0; font-size: 14px; line-height: 19.6px; color: var(--text); }
  ul { margin: 18px 0 0; padding-left: 25px; font-size: 14px; line-height: 19.6px; color: var(--text); }
  @media (max-width: 760px) {
    .detail { padding: 28px 24px 32px; }
  }
</style>
