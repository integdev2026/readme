---
// Light-weight Open Sans section title (40px/56px on the live pages) with optional sub-line.
// `title` accepts HTML so words can be wrapped in <span class="gold">.
interface Props { title: string; sub?: string; align?: 'center' | 'left'; tag?: 'h2' | 'h3' }
const { title, sub, align = 'center', tag: Tag = 'h2' } = Astro.props;
---
<div class:list={['heading', align]}>
  <Tag set:html={title} />
  {sub && <p>{sub}</p>}
</div>

<style>
  .heading { margin: 0 auto 32px; max-width: 960px; }
  .center { text-align: center; }
  .heading :global(h2), .heading :global(h3) { font-weight: 400; font-size: 40px; line-height: 56px; color: var(--text); }
  p { margin: 12px auto 0; max-width: 820px; font-size: 16px; line-height: 22.4px; color: var(--ink); }
  @media (max-width: 760px) {
    .heading :global(h2), .heading :global(h3) { font-size: 28px; line-height: 38px; }
  }
</style>
