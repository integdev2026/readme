---
// Page body shared by the ISO 27001 and ISO 13485 pages: hero, "What is", detail-card grid,
// beige "why" grid, industries grid and the closing CTA panel. The "What is" copy goes in the default slot.
import PageHero from '../PageHero.astro';
import Heading from './Heading.astro';
import Pill from './Pill.astro';
import FeatureCard from './FeatureCard.astro';
import DetailCard from './DetailCard.astro';
import CtaStats from './CtaStats.astro';
import { headlineStats, type Feature, type Detail } from './data';

interface Props {
  hero: { title: string; text: string; ticks: string[]; image: string; imageAlt: string; learnHref: string };
  intro: { id: string; eyebrow: string; title: string; features: Feature[] };
  details: { title: string; sub: string; cards: Detail[]; pill: string };
  why: { title: string; sub: string; features: Feature[] };
  industries: { title: string; sub: string; cards: Detail[] };
  cta: { title: string; paragraphs: string[] };
}
const { hero, intro, details, why, industries, cta } = Astro.props;
---
<div class="std-hero">
  <PageHero
    title={hero.title}
    text={hero.text}
    ticks={hero.ticks}
    actions={[
      { label: 'Start Your Journey', href: '/free-consultation' },
      { label: 'Learn More', href: hero.learnHref, primary: false },
    ]}
    image={hero.image}
    imageAlt={hero.imageAlt}
    stats={headlineStats}
  />
</div>

<section class="intro" id={intro.id}>
  <div class="container intro-grid">
    <div class="intro-copy">
      <Pill text={intro.eyebrow} />
      <h2>{intro.title}</h2>
      <div class="body"><slot /></div>
    </div>
    <div class="feature-grid">
      {intro.features.map((f) => <FeatureCard {...f} />)}
    </div>
  </div>
</section>

<section class="details">
  <div class="container">
    <Heading title={details.title} sub={details.sub} />
    <div class="detail-grid">
      {details.cards.map((c) => <DetailCard {...c} />)}
    </div>
    <p class="pill-row"><Pill as="span" size="md" text={details.pill} /></p>
  </div>
</section>

<section class="why">
  <div class="container">
    <Heading title={why.title} sub={why.sub} />
    <div class="why-grid">
      {why.features.map((f) => <FeatureCard {...f} />)}
    </div>
  </div>
</section>

<section class="industries">
  <div class="container">
    <Heading title={industries.title} sub={industries.sub} />
    <div class="detail-grid">
      {industries.cards.map((c) => <DetailCard {...c} />)}
    </div>
  </div>
</section>

<CtaStats title={cta.title} paragraphs={cta.paragraphs} />

<style>
  /* Hero: bordered photo frame as on the live page */
  .std-hero :global(.page-hero) { padding: 64px 0 90px; }
  .std-hero :global(.page-hero h1) { font-size: 40px; line-height: 56px; color: var(--ink); }
  .std-hero :global(.page-hero .lead) { max-width: 460px; margin-top: 4px; color: var(--text); }
  .std-hero :global(.page-hero .ticks) { font-size: 16px; gap: 4px; color: var(--text); }
  .std-hero :global(.page-hero .actions) { gap: 10px; margin-top: 18px; }
  .std-hero :global(.page-hero .actions .btn) { min-width: 184px; justify-content: center; }
  .std-hero :global(.page-hero .media) { padding: 2px; border: 2px solid #d9d9d9; border-radius: 6px; overflow: hidden; }
  .std-hero :global(.page-hero .media img) { aspect-ratio: 466 / 377; border-radius: 4px; }
  .std-hero :global(.page-hero .stat-card) { margin: -96px 14px 0; justify-content: flex-start; gap: 56px; padding: 18px 52px 16px; border-radius: 16px 16px 0 0; box-shadow: none; }
  .std-hero :global(.page-hero .stat-card dd) { max-width: 90px; font-size: 14px; line-height: 20px; }

  /* What is */
  .intro { padding: 60px 0 70px; }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 370px) minmax(0, 1fr); gap: 20px; align-items: start; }
  .intro-copy { padding-left: 12px; }
  .intro-copy h2 { margin-top: 6px; font-weight: 400; font-size: 40px; line-height: 48px; color: var(--ink); }
  .body { margin-top: 20px; font-size: 14px; line-height: 19.6px; color: var(--text); }
  .body :global(p) { margin: 0 0 19.6px; }
  .body :global(ul) { margin: 0 0 19.6px; padding-left: 25px; }
  .body :global(p:has(+ ul)) { margin-bottom: 0; }
  .feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 42px 26px; margin-top: 30px; }

  /* Detail cards */
  .details { padding: 20px 0 36px; }
  .detail-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .pill-row { margin: 36px 0 0; text-align: center; }

  /* Why (beige band) */
  .why { padding: 24px 0 110px; background: #f0ebd9; }
  .why-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 60px 26px; align-items: start; }
  .why-grid :global(.feature) { padding: 36px 26px 36px 22px; }

  .industries { padding: 44px 0 30px; }

  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: 1fr; gap: 12px; }
    .detail-grid, .why-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .std-hero :global(.page-hero) { padding: 40px 0 56px; }
    .std-hero :global(.page-hero h1) { font-size: 30px; line-height: 40px; }
    .std-hero :global(.page-hero .stat-card) { margin: 0; gap: 20px; padding: 16px 20px; justify-content: space-between; border-radius: 0; }
    .intro { padding: 40px 0 48px; }
    .intro-copy { padding-left: 0; }
    .intro-copy h2 { font-size: 30px; line-height: 40px; }
    .feature-grid, .detail-grid, .why-grid { grid-template-columns: 1fr; gap: 16px; }
    .why { padding-bottom: 56px; }
  }
</style>
